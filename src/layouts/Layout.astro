---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  activeNav?: string;
}

const {
  title,
  description = 'Universal Dendrimer Builder (UDB): an open-source Python application for building, parameterizing, and simulating dendrimer nanostructures with AMBER and NAMD.',
  image = '/images/og-default.png',
  activeNav,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://udb.example.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title} | Universal Dendrimer Builder</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | Universal Dendrimer Builder`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Universal Dendrimer Builder" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Universal Dendrimer Builder`} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts (self-served fallback via Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Scroll-driven atmosphere: colour is a pure function of scroll position,
         so scrolling back up reverses through the exact same hues. -->
    <div class="atmosphere" aria-hidden="true"></div>
    <div class="atmosphere-tint" aria-hidden="true"></div>
    <!-- Pointer spotlight: a soft light that follows the cursor -->
    <div class="spotlight" aria-hidden="true"></div>

    <!-- Scroll-progress bar (top, fills as the page scrolls) -->
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>

    <Nav activeNav={activeNav} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Back-to-top: fades in after scrolling, smooth-scrolls home -->
    <button id="back-to-top" class="back-to-top" aria-label="Back to top" title="Back to top">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 15l7-7 7 7"/>
      </svg>
    </button>

    <!-- Scroll-reveal + count-up: progressive enhancement, no deps -->
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveal elements as they enter the viewport.
      const revealEls = document.querySelectorAll('.reveal');
      if (reduceMotion) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // Count-up for [data-countup] (value lives in data-to, supports prefix/suffix).
      const easeOut = (t) => 1 - Math.pow(1 - t, 3);
      const animateCount = (el) => {
        const to = parseFloat(el.getAttribute('data-to') || '0');
        const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
        const prefix = el.getAttribute('data-prefix') || '';
        const suffix = el.getAttribute('data-suffix') || '';
        if (reduceMotion) {
          el.textContent = prefix + to.toFixed(decimals) + suffix;
          return;
        }
        const dur = 1400;
        const start = performance.now();
        const tick = (now) => {
          const p = Math.min(1, (now - start) / dur);
          const v = to * easeOut(p);
          el.textContent = prefix + v.toFixed(decimals) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const counters = document.querySelectorAll('[data-countup]');
      if ('IntersectionObserver' in window && counters.length) {
        const co = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animateCount(entry.target);
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.6 }
        );
        counters.forEach((el) => co.observe(el));
      } else {
        counters.forEach((el) => animateCount(el));
      }

      // ── Scroll-driven atmosphere ──
      // The background colour is interpolated from these stops by scroll
      // fraction. Because it's a pure function of position, scrolling up
      // walks back through the same colours — the reversal is automatic.
      const ATMO_STOPS = [
        [14, 165, 233],  // sky      (top of page)
        [34, 211, 238],  // cyan
        [45, 212, 191],  // teal
        [139, 92, 246],  // violet
        [52, 211, 153],  // emerald  (bottom of page)
      ];
      const FLOOR = [2, 6, 23]; // slate-950, the dark base
      const lerp = (a, b, t) => a + (b - a) * t;
      const mix = (c1, c2, t) => [
        Math.round(lerp(c1[0], c2[0], t)),
        Math.round(lerp(c1[1], c2[1], t)),
        Math.round(lerp(c1[2], c2[2], t)),
      ];
      const rgb = (c) => `rgb(${c[0]},${c[1]},${c[2]})`;
      // pull a colour toward its own grey (luminance) to lower saturation.
      // 0 = full colour, 1 = fully grey. DESAT is the global saturation knob.
      const DESAT = 0.6;
      const desat = (c, a = DESAT) => {
        const g = 0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2];
        return [Math.round(lerp(c[0], g, a)), Math.round(lerp(c[1], g, a)), Math.round(lerp(c[2], g, a))];
      };
      // colour along the multi-stop ramp for a 0..1 fraction
      const rampColor = (f) => {
        const n = ATMO_STOPS.length - 1;
        const seg = Math.min(n - 1, Math.floor(f * n));
        const local = f * n - seg;
        return mix(ATMO_STOPS[seg], ATMO_STOPS[seg + 1], local);
      };

      const progress = document.getElementById('scroll-progress');
      const toTop = document.getElementById('back-to-top');
      const root = document.documentElement;
      const parallaxEls = Array.from(document.querySelectorAll('.parallax'));

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const max = root.scrollHeight - root.clientHeight;
          const frac = max > 0 ? Math.min(1, Math.max(0, root.scrollTop / max)) : 0;

          if (progress) progress.style.width = frac * 100 + '%';
          if (toTop) toTop.classList.toggle('is-visible', root.scrollTop > 600);

          if (!reduceMotion) {
            const tint = desat(rampColor(frac));
            // base wash: a heavily darkened version of the same hue
            const washTop = mix(FLOOR, tint, 0.14);
            root.style.setProperty('--atmo-tint', rgb(tint));
            root.style.setProperty('--atmo-1', rgb(washTop));
            root.style.setProperty('--atmo-2', rgb(FLOOR));
            // drift the tint's focal point down the page as we scroll
            root.style.setProperty('--atmo-tint-y', (15 + frac * 45) + '%');

            // parallax: each element lags scroll by its own speed
            const y = root.scrollTop;
            for (const el of parallaxEls) {
              const speed = parseFloat(el.getAttribute('data-parallax-speed') || '0.15');
              el.style.setProperty('--parallax', (y * speed) + 'px');
            }
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      toTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      });

      // ── Pointer spotlight + card tilt (fine-pointer, motion-friendly only) ──
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (!reduceMotion && finePointer) {
        const spotlight = document.querySelector('.spotlight');
        let spotTick = false;
        window.addEventListener('pointermove', (e) => {
          if (spotTick) return;
          spotTick = true;
          requestAnimationFrame(() => {
            if (spotlight) {
              spotlight.style.setProperty('--spot-x', e.clientX + 'px');
              spotlight.style.setProperty('--spot-y', e.clientY + 'px');
              spotlight.style.setProperty('--spot-a', '1');
            }
            spotTick = false;
          });
        }, { passive: true });

        // 3D tilt toward the cursor on cards + opted-in tiles. A snappy
        // transition is applied inline only while tilting so it doesn't
        // clobber the slower .reveal fade on these same elements.
        const MAX_TILT = 6; // degrees
        const tiltEls = document.querySelectorAll('.card, [data-tilt]');
        tiltEls.forEach((el) => {
          el.addEventListener('pointerenter', () => {
            el.style.transition = 'transform 0.12s cubic-bezier(0.22,1,0.36,1)';
          });
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            el.style.transform =
              `perspective(760px) rotateX(${(-py * MAX_TILT).toFixed(2)}deg) ` +
              `rotateY(${(px * MAX_TILT).toFixed(2)}deg) translateZ(0) scale(1.015)`;
          });
          el.addEventListener('pointerleave', () => {
            el.style.transform = '';
            // let the element settle back, then hand transitions back to CSS
            window.setTimeout(() => { el.style.transition = ''; }, 200);
          });
        });
      }
    </script>
  </body>
</html>
