---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RevealInit from '../components/RevealInit.astro';
import ScienceCanvas from '../components/ScienceCanvas.astro';
import LiquidGlass from '../components/LiquidGlass.astro';
import PerfTier from '../components/PerfTier.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  activeNav?: string;
}

const {
  title,
  description = 'Universal Dendrimer Builder (UDB) - open-source Python application for building, parameterizing, and simulating dendrimer nanostructures with AMBER and NAMD.',
  image = '/images/og-default.jpg',
  activeNav,
} = Astro.props;

const site = Astro.site ?? new URL('https://universal-dendrimer-builder-showcas.vercel.app');
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = new URL(image, site);   // social cards require an absolute URL
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <!-- Remove the no-js guard before paint so JS users get scroll-reveal;
         if JS is disabled, `.no-js .reveal` keeps all content visible. -->
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <!-- Device tier (high/mid/low) before first paint; see PerfTier.astro -->
    <PerfTier />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title} | Universal Dendrimer Builder</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | Universal Dendrimer Builder`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Universal Dendrimer Builder" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Universal Dendrimer Builder`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Inter (text) · Space Grotesk (display) · JetBrains Mono (data).
         Loaded once here (was also @import-ed from global.css → a render-blocking chain). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&family=Space+Grotesk:wght@400..700&family=JetBrains+Mono:wght@400..700&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#04070e" />
  </head>
  <body class="min-h-screen flex flex-col" style="background:#04070e">
    <ScienceCanvas intensity={0.82} />
    <LiquidGlass />
    <Nav activeNav={activeNav} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <RevealInit />
  </body>
</html>
