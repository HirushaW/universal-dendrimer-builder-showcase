---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import RevealInit from '../components/RevealInit.astro';
import ScienceCanvas from '../components/ScienceCanvas.astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  activeNav?: string;
}

const {
  title,
  description = 'Universal Dendrimer Builder (UDB) - open-source Python application for building, parameterizing, and simulating dendrimer nanostructures with AMBER and NAMD.',
  image = '/images/og-default.png',
  activeNav,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://udb.example.com');
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <!-- Remove the no-js guard before paint so JS users get scroll-reveal;
         if JS is disabled, `.no-js .reveal` keeps all content visible. -->
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title} | Universal Dendrimer Builder</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | Universal Dendrimer Builder`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Universal Dendrimer Builder" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Universal Dendrimer Builder`} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts (self-served fallback via Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col" style="background:#04070e">
    <ScienceCanvas intensity={0.82} />
    <Nav activeNav={activeNav} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <RevealInit />
    <SpeedInsights />
  </body>
</html>
