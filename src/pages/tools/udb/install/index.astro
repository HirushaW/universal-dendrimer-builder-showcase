---
import Layout from '../../../../layouts/Layout.astro';
---

<Layout title="Install UDB" description="Install Universal Dendrimer Builder on Linux with AmberTools25 and NAMD 3.x." activeNav="tools">

  <!-- Header -->
  <div class="bg-gradient-to-br from-slate-950 to-slate-900 border-b border-slate-800 py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-sm text-slate-500 mb-4">
        <a href="/" class="hover:text-teal-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/tools/udb/" class="hover:text-teal-400 transition-colors">UDB</a>
        <span>/</span>
        <span class="text-slate-300">Install</span>
      </div>
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Installation</h1>
      <p class="text-lg text-slate-400">
        UDB runs on Linux (Ubuntu 20.04+). This guide covers the full dependency stack:
        Conda, AmberTools25, NAMD 3.x, and Python requirements.
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        <span class="badge bg-slate-800 text-slate-300 border border-slate-700">Linux / Ubuntu 20.04+</span>
        <span class="badge bg-teal-500/10 text-teal-400 border border-teal-500/20">AmberTools25</span>
        <span class="badge bg-sky-500/10 text-sky-400 border border-sky-500/20">NAMD 3.x</span>
        <span class="badge bg-slate-800 text-slate-300 border border-slate-700">Python 3.8+</span>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">

    <!-- Requirements -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">System Requirements</h2>
      <div class="overflow-x-auto rounded-xl border border-slate-700">
        <table class="table-scientific">
          <thead>
            <tr><th>Component</th><th>Minimum</th><th>Recommended</th><th>Notes</th></tr>
          </thead>
          <tbody>
            <tr><td class="font-medium text-slate-200">OS</td><td>Ubuntu 20.04</td><td>Ubuntu 22.04+</td><td>x86_64 only for NAMD</td></tr>
            <tr><td class="font-medium text-slate-200">Python</td><td>3.8</td><td>3.10+</td><td>System or conda</td></tr>
            <tr><td class="font-medium text-slate-200">RAM</td><td>4 GB</td><td>16 GB</td><td>G6+ dendrimers benefit from more</td></tr>
            <tr><td class="font-medium text-slate-200">CPU</td><td>Any x86_64</td><td>Multi-core</td><td>AVX512 CPUs: see Known Issues</td></tr>
            <tr><td class="font-medium text-slate-200">Disk</td><td>5 GB</td><td>20 GB</td><td>AmberTools25 + NAMD binaries</td></tr>
            <tr><td class="font-medium text-slate-200">Display</td><td>1280×720</td><td>1920×1080</td><td>Required for Tkinter GUI</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Step 1 -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded-full bg-teal-500/20 border border-teal-500/40 flex items-center justify-center text-teal-400 font-bold text-sm shrink-0">1</div>
        <h2 class="text-xl font-bold text-slate-100">Install Miniconda (if not already installed)</h2>
      </div>
      <div class="ml-11">
        <p class="text-slate-400 text-sm mb-3">
          UDB requires Conda for managing the AmberTools25 environment.
          Skip this step if Miniconda or Anaconda is already installed.
        </p>
        <div class="code-block p-4 mb-3">
          <div class="text-slate-500 text-xs mb-2 font-mono"># Download and install Miniconda3</div>
          <pre class="text-slate-200 text-sm leading-relaxed">wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh
bash Miniconda3-latest-Linux-x86_64.sh -b -p $HOME/miniconda3
source $HOME/miniconda3/bin/activate
conda init bash</pre>
        </div>
        <div class="flex items-start gap-2 p-3 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs">
          <svg class="w-4 h-4 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <span>
            <strong>Important:</strong> Use <code class="font-mono bg-amber-500/20 px-1 rounded">source ~/miniconda3/bin/activate</code> in scripts,
            not <code class="font-mono bg-amber-500/20 px-1 rounded">conda activate</code>. The <code class="font-mono">conda activate</code>
            command requires an interactive shell and will silently fail in shell scripts.
          </span>
        </div>
      </div>
    </section>

    <!-- Step 2 -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded-full bg-teal-500/20 border border-teal-500/40 flex items-center justify-center text-teal-400 font-bold text-sm shrink-0">2</div>
        <h2 class="text-xl font-bold text-slate-100">Install AmberTools25</h2>
      </div>
      <div class="ml-11">
        <p class="text-slate-400 text-sm mb-3">
          AmberTools25 provides <code class="text-teal-300 bg-slate-800 px-1 rounded text-sm">antechamber</code>,
          <code class="text-teal-300 bg-slate-800 px-1 rounded text-sm">parmchk2</code>,
          <code class="text-teal-300 bg-slate-800 px-1 rounded text-sm">tleap</code>, and
          <code class="text-teal-300 bg-slate-800 px-1 rounded text-sm">sander</code>
          — all required for GAFF2 parameterization.
        </p>
        <div class="code-block p-4 mb-3">
          <div class="text-slate-500 text-xs mb-2 font-mono"># Create and activate the AmberTools25 environment</div>
          <pre class="text-slate-200 text-sm leading-relaxed">conda create -n AmberTools25 -c conda-forge ambertools=25 -y
conda activate AmberTools25</pre>
        </div>
        <div class="flex items-start gap-2 p-3 rounded-lg bg-slate-800 border border-slate-700 text-slate-400 text-xs">
          <svg class="w-4 h-4 mt-0.5 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>
            The conda-forge AmberTools package includes serial <code class="font-mono bg-slate-700 px-1 rounded">sander</code> only.
            <code class="font-mono bg-slate-700 px-1 rounded">sander.MPI</code> is not included — see
            <a href="/tools/udb/limitations/" class="text-teal-400 hover:text-teal-300">Known Limitations</a> if you need parallel MD runs.
          </span>
        </div>
      </div>
    </section>

    <!-- Step 3 -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded-full bg-teal-500/20 border border-teal-500/40 flex items-center justify-center text-teal-400 font-bold text-sm shrink-0">3</div>
        <h2 class="text-xl font-bold text-slate-100">Install Python Dependencies</h2>
      </div>
      <div class="ml-11">
        <p class="text-slate-400 text-sm mb-3">
          With the AmberTools25 environment active, install UDB's Python dependencies:
        </p>
        <div class="code-block p-4 mb-3">
          <div class="text-slate-500 text-xs mb-2 font-mono"># Core dependencies (required)</div>
          <pre class="text-slate-200 text-sm leading-relaxed">conda activate AmberTools25
pip install numpy scipy matplotlib</pre>
        </div>
        <div class="code-block p-4 mb-3">
          <div class="text-slate-500 text-xs mb-2 font-mono"># tkinter (usually bundled with Python, install if missing)</div>
          <pre class="text-slate-200 text-sm leading-relaxed">sudo apt-get install python3-tk   # Ubuntu/Debian</pre>
        </div>
        <div class="code-block p-4 mb-3">
          <div class="text-slate-500 text-xs mb-2 font-mono"># Optional: OpenBabel for additional mol2 handling</div>
          <pre class="text-slate-200 text-sm leading-relaxed">conda install -c conda-forge openbabel -y</pre>
        </div>
        <div class="overflow-x-auto rounded-lg border border-slate-700 mt-4">
          <table class="table-scientific">
            <thead>
              <tr><th>Package</th><th>Required</th><th>Purpose</th></tr>
            </thead>
            <tbody>
              <tr><td class="font-mono text-teal-300 text-sm">numpy</td><td class="text-teal-400">Required</td><td class="text-slate-400">Array operations, coordinate geometry</td></tr>
              <tr><td class="font-mono text-teal-300 text-sm">scipy</td><td class="text-teal-400">Required</td><td class="text-slate-400">Minimization, spatial computations</td></tr>
              <tr><td class="font-mono text-teal-300 text-sm">matplotlib</td><td class="text-teal-400">Required</td><td class="text-slate-400">Characterization plots</td></tr>
              <tr><td class="font-mono text-teal-300 text-sm">tkinter</td><td class="text-teal-400">Required</td><td class="text-slate-400">GUI framework</td></tr>
              <tr><td class="font-mono text-teal-300 text-sm">openbabel</td><td class="text-amber-400">Optional</td><td class="text-slate-400">Extended mol2 format support</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Step 4 -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded-full bg-teal-500/20 border border-teal-500/40 flex items-center justify-center text-teal-400 font-bold text-sm shrink-0">4</div>
        <h2 class="text-xl font-bold text-slate-100">Install NAMD 3.x</h2>
      </div>
      <div class="ml-11">
        <p class="text-slate-400 text-sm mb-3">
          NAMD 3.x is required for MD simulation. Download the precompiled Linux x86_64 multicore binary
          from the <a href="https://www.ks.uiuc.edu/Development/Download/download.cgi?PackageName=NAMD" target="_blank" rel="noopener noreferrer" class="text-teal-400 hover:text-teal-300">NAMD download page</a>
          (free registration required).
        </p>
        <div class="code-block p-4 mb-3">
          <div class="text-slate-500 text-xs mb-2 font-mono"># After downloading NAMD_3.0.x_Linux-x86_64-multicore.tar.gz</div>
          <pre class="text-slate-200 text-sm leading-relaxed">sudo mkdir -p /opt/namd
sudo tar -xzf NAMD_3.0.x_Linux-x86_64-multicore.tar.gz -C /opt/namd
# Verify the binary is executable
/opt/namd/NAMD_3.0.x_Linux-x86_64-multicore/namd3 --version</pre>
        </div>
        <div class="flex items-start gap-2 p-3 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs">
          <svg class="w-4 h-4 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <span>
            <strong>NAMD requires x86_64.</strong> ARM64 systems (Apple Silicon, some ARM servers)
            are not supported by the precompiled binary.
            If you get an "Exec format error", you are on an incompatible architecture.
            See <a href="/tools/udb/limitations/" class="text-amber-200 underline">Known Limitations</a>.
          </span>
        </div>
      </div>
    </section>

    <!-- Step 5 -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded-full bg-teal-500/20 border border-teal-500/40 flex items-center justify-center text-teal-400 font-bold text-sm shrink-0">5</div>
        <h2 class="text-xl font-bold text-slate-100">Configure NAMD Path in UDB</h2>
      </div>
      <div class="ml-11">
        <p class="text-slate-400 text-sm mb-3">
          UDB needs to know where the NAMD binary is. The default path is:
        </p>
        <div class="code-block p-4 mb-3">
          <pre class="text-slate-200 text-sm">/opt/namd/NAMD_3.0.x_Linux-x86_64-multicore/namd3</pre>
        </div>
        <p class="text-slate-400 text-sm">
          If you installed NAMD elsewhere, update the path in the UDB
          <strong class="text-slate-200"> Settings</strong> tab or edit
          the <code class="text-teal-300 bg-slate-800 px-1 rounded text-sm">NAMD_PATH</code> constant
          near the top of <code class="text-teal-300 bg-slate-800 px-1 rounded text-sm">universal_dendrimer_builder_v1_0.py</code>.
        </p>
      </div>
    </section>

    <!-- Step 6 -->
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded-full bg-teal-500/20 border border-teal-500/40 flex items-center justify-center text-teal-400 font-bold text-sm shrink-0">6</div>
        <h2 class="text-xl font-bold text-slate-100">Launch UDB</h2>
      </div>
      <div class="ml-11">
        <div class="code-block p-4 mb-3">
          <div class="text-slate-500 text-xs mb-2 font-mono"># Activate environment and launch</div>
          <pre class="text-slate-200 text-sm leading-relaxed">conda activate AmberTools25
python3 universal_dendrimer_builder_v1_0.py</pre>
        </div>
        <p class="text-slate-400 text-sm">
          The UDB main window should open. If you see a blank window or Tkinter errors,
          ensure that a display (X11 or Wayland) is available and that
          <code class="text-teal-300 bg-slate-800 px-1 rounded text-sm">python3-tk</code> is installed.
        </p>
      </div>
    </section>

    <!-- Known install issues -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">Known Installation Issues</h2>
      <div class="space-y-4">
        {[
          {
            severity: 'high',
            title: 'AVX512 incompatibility',
            problem: 'NAMD crashes immediately with "Illegal instruction" on CPUs that advertise AVX512 support but implement it incorrectly (some early Skylake-X units).',
            fix: 'Check if your CPU has a known AVX512 bug: grep avx512 /proc/cpuinfo. If affected, download the non-AVX512 NAMD build from the NAMD site, or set NAMD_DISABLE_AVX512=1 if a recent NAMD version provides that flag.',
          },
          {
            severity: 'medium',
            title: 'conda activate fails in shell scripts',
            problem: 'Running conda activate inside a .sh script without sourcing the conda init file first silently fails — the environment is not activated and AmberTools binaries are not found.',
            fix: 'Use: source ~/miniconda3/bin/activate AmberTools25 in scripts. Do not use conda activate in non-interactive shell contexts.',
          },
          {
            severity: 'medium',
            title: 'antechamber MAXBOND limit',
            problem: 'AmberTools antechamber has an internal MAXBOND limit (~400 atoms for full-molecule AM1-BCC). Building G4+ PAMAM as a single molecule will hit this limit.',
            fix: 'UDB uses Fragment BCC mode for large dendrimers — charge each residue separately. See the Parameterization tab in UDB and the Limitations page.',
          },
          {
            severity: 'low',
            title: 'tkinter not found',
            problem: 'On minimal Ubuntu server installs, python3-tk is not included with Python.',
            fix: 'Install it: sudo apt-get install python3-tk',
          },
          {
            severity: 'low',
            title: 'OpenBabel optional dependency missing',
            problem: 'If openbabel is not installed, certain mol2 format conversions are unavailable. UDB will warn but continue with built-in parsers.',
            fix: 'conda install -c conda-forge openbabel (optional)',
          },
        ].map(item => (
          <div class={`limitation-item limitation-severity-${item.severity}`}>
            <div class="flex-1">
              <h3 class="text-slate-200 font-semibold text-sm mb-1">{item.title}</h3>
              <p class="text-slate-400 text-sm mb-2"><strong class="text-slate-300">Problem:</strong> {item.problem}</p>
              <p class="text-slate-400 text-sm"><strong class="text-teal-400">Fix:</strong> {item.fix}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Verification -->
    <section>
      <h2 class="text-2xl font-bold text-slate-100 mb-4">Verify Your Installation</h2>
      <div class="code-block p-4">
        <div class="text-slate-500 text-xs mb-2 font-mono"># Quick verification — all these should succeed</div>
        <pre class="text-slate-200 text-sm leading-relaxed">conda activate AmberTools25
python3 -c "import numpy, scipy, matplotlib, tkinter; print('Python deps OK')"
antechamber -h 2>&1 | head -1       # Should show antechamber version
parmchk2 -h 2>&1 | head -1          # Should show parmchk2 version
tleap -h 2>&1 | head -1             # Should show tleap version
/opt/namd/NAMD_3.0.x_Linux-x86_64-multicore/namd3 --version</pre>
      </div>
    </section>

    <div class="mt-12 flex gap-4">
      <a href="/tools/udb/manual/" class="btn-primary">Continue to Manual →</a>
      <a href="/tools/udb/limitations/" class="btn-outline">Known Limitations</a>
    </div>

  </div>
</Layout>
