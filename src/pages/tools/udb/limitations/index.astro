---
import Layout from '../../../../layouts/Layout.astro';

const limitations = [
  {
    id: 'cgenff-si',
    severity: 'high',
    category: 'Force Field',
    title: 'CGenFF + Silicon Incompatibility',
    problem: 'CGenFF does not include parameters for silicon-containing fragments. Attempting to parameterize Carbosilane dendrimers with CGenFF will either fail outright or produce parameters with very large penalties (>200) that indicate essentially missing parameters.',
    workaround: 'Use the GAFF2 manual bypass for Carbosilane dendrimers. In the Parameterize tab, select GAFF2 and uncheck "Auto-detect CGenFF". Manually verify the .frcmod file for Si parameters before running NAMD.',
    affected: ['Carbosilane'],
    status: 'No fix planned — CGenFF limitation',
  },
  {
    id: 'bcc-limit',
    severity: 'high',
    category: 'Parameterization',
    title: 'AM1-BCC Charge Limit (~500 bonds per fragment)',
    problem: 'AmberTools antechamber has an internal MAXBOND constant that limits AM1-BCC calculation to molecules under approximately 500 bonds. PAMAM G3 (516 atoms) and larger dendrimers exceed this when treated as single molecules.',
    workaround: 'UDB uses Fragment BCC mode by default — each residue is charged separately. For residues themselves exceeding ~500 bonds (rare but possible in custom types), switch the charge method to Gasteiger in the Parameterize tab dropdown. Gasteiger charges are less accurate but will not cause failures.',
    affected: ['All types at G3+ if not using Fragment BCC', 'Custom types with large repeat units'],
    status: 'Mitigated by Fragment BCC mode in UDB',
  },
  {
    id: 'maxbond',
    severity: 'high',
    category: 'Parameterization',
    title: 'antechamber MAXBOND Constraint',
    problem: 'Even in Fragment BCC mode, if a single residue/fragment exceeds the MAXBOND limit (hardcoded as a constant in the antechamber C source), the charge calculation will fail silently or produce garbage. The default MAXBOND in AmberTools25 is 400 bonds for full antechamber processing.',
    workaround: 'For affected fragments: (1) switch to Gasteiger charges; or (2) manually recompile AmberTools with a higher MAXBOND constant (advanced users only); or (3) split the residue at a conformationally flexible point and treat it as two sub-fragments.',
    affected: ['Large custom residues', 'G3+ for non-Fragment-BCC paths'],
    status: 'Inherent AmberTools constraint — not fixable in UDB',
  },
  {
    id: 'sander-mpi',
    severity: 'medium',
    category: 'MD Simulation',
    title: 'sander.MPI Not Available via Conda',
    problem: 'The conda-forge AmberTools25 package ships serial sander only. sander.MPI (for parallel AMBER MD runs) is not included. Attempting to run sander.MPI will produce "command not found".',
    workaround: 'For parallel AMBER MD: compile AmberTools from source with MPI enabled (requires a working MPI installation and a compiler). Alternatively, use NAMD (which is multi-core by default in the provided binary) for production MD. UDB\'s primary MD engine is NAMD, not sander — this limitation only affects users who want AMBER sander for production runs.',
    affected: ['Users requiring parallel AMBER MD'],
    status: 'Out of scope for UDB (primary engine is NAMD)',
  },
  {
    id: 'namd-arch',
    severity: 'medium',
    category: 'MD Simulation',
    title: 'NAMD x86_64 vs ARM64 Binary Mismatch',
    problem: 'The precompiled NAMD 3.x Linux binary is x86_64 only. Running it on ARM64 systems (Raspberry Pi, ARM servers, Apple Silicon via WSL, etc.) produces an "Exec format error" or segmentation fault.',
    workaround: 'On ARM64: compile NAMD from source (the NAMD source tree is available from UIUC with free registration). On Apple Silicon Macs: use Rosetta 2 with an x86_64 Linux VM or Docker. There is no official NAMD ARM64 Linux binary as of NAMD 3.0.',
    affected: ['ARM64 Linux systems', 'Apple Silicon Macs running Linux VMs'],
    status: 'NAMD project limitation — monitor namd.ks.uiuc.edu for ARM builds',
  },
  {
    id: 'avx512',
    severity: 'medium',
    category: 'Platform',
    title: 'AVX512 Incompatibility on Certain CPUs',
    problem: 'Some early Skylake-X and Knights Landing processors advertise AVX512 support in /proc/cpuinfo but contain errata that cause illegal instruction traps when AVX512 vectorized code runs. NAMD\'s AVX512 optimized binary path may crash on these processors.',
    workaround: 'Check CPU errata for your specific processor model. If affected: (1) download the non-AVX512 NAMD build variant from the NAMD download page; or (2) set the environment variable NAMD_DISABLE_AVX512=1 before running (if supported by your NAMD version). Confirm with: grep avx512 /proc/cpuinfo to see if AVX512 flags are present.',
    affected: ['Skylake-X Xeon (some units, 2017–2018)', 'Knights Landing (specific steppings)'],
    status: 'CPU errata — select appropriate NAMD binary',
  },
  {
    id: 'conda-activate',
    severity: 'low',
    category: 'Platform',
    title: 'conda activate Fails in Shell Scripts',
    problem: 'conda activate is a shell function, not an executable. It requires an interactive shell with conda init already run. Running conda activate in a non-interactive shell script (e.g., a .sh run via cron or as a subprocess) will silently fail — the environment appears to activate but AmberTools binaries are not on PATH.',
    workaround: 'In any shell script that needs AmberTools, use: source ~/miniconda3/bin/activate AmberTools25. This directly sources the activation script and works in non-interactive contexts. UDB\'s internal subprocess calls already handle this correctly.',
    affected: ['Custom shell scripts wrapping UDB', 'Automated batch runs'],
    status: 'Conda design — use source activation in scripts',
  },
  {
    id: 'g7-plus',
    severity: 'low',
    category: 'Performance',
    title: 'High-Generation Dendrimers (G7+) Build Slowly',
    problem: 'G7+ PAMAM structures contain >8,000 atoms. The SA placement engine\'s O(N²) pairwise clash checking becomes slow at these sizes. G10 PAMAM (estimated ~50,000 atoms) may take tens of minutes on a single core.',
    workaround: 'For G7+: increase SA_STEPS only if needed (default is sufficient for most cases), use a machine with fast single-thread performance, and be patient. No parallel placement engine is implemented in v1.0.',
    affected: ['G7–G10 all types'],
    status: 'Performance limitation — parallel SA planned for v2.0',
  },
];
---

<Layout title="Known Limitations" description="UDB known limitations, incompatibilities, and workarounds — an honest account of what UDB v1.0 cannot do." activeNav="tools">

  <div class="bg-gradient-to-br from-slate-950 to-slate-900 border-b border-slate-800 py-14">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-sm text-slate-500 mb-4">
        <a href="/" class="hover:text-teal-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/tools/udb/" class="hover:text-teal-400 transition-colors">UDB</a>
        <span>/</span>
        <span class="text-slate-300">Limitations</span>
      </div>
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Known Limitations</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        An honest account of UDB v1.0 constraints, incompatibilities, and known failure modes.
        Each entry includes a practical workaround where one exists.
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">

    <!-- Why this page -->
    <section class="mb-12">
      <div class="p-5 rounded-xl bg-slate-900 border border-slate-700">
        <p class="text-slate-300 text-sm leading-relaxed">
          No simulation software is without limitations. This page documents the known failure modes in UDB v1.0,
          the boundary conditions under which they occur, and what to do about them.
          Knowing these upfront saves debugging time.
          If you encounter an issue not listed here,
          <a href="https://github.com/" target="_blank" rel="noopener noreferrer" class="text-teal-400 hover:text-teal-300">open a GitHub issue</a>.
        </p>
      </div>

      <!-- Severity key -->
      <div class="mt-4 flex flex-wrap gap-3 text-xs">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-sm bg-red-500"></span>
          <span class="text-slate-400"><strong class="text-slate-200">High:</strong> Will cause build/param failure</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-sm bg-amber-500"></span>
          <span class="text-slate-400"><strong class="text-slate-200">Medium:</strong> Workflow degraded, workaround available</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-sm bg-slate-500"></span>
          <span class="text-slate-400"><strong class="text-slate-200">Low:</strong> Minor inconvenience</span>
        </div>
      </div>
    </section>

    <!-- Limitations list -->
    <div class="space-y-6">
      {limitations.map(lim => (
        <div id={lim.id} class={`limitation-item limitation-severity-${lim.severity}`}>
          <div class="flex-1">
            <div class="flex flex-wrap items-start gap-2 mb-2">
              <span class={`badge text-xs px-2 py-0.5 ${lim.severity === 'high' ? 'bg-red-500/15 text-red-400 border border-red-500/20' : lim.severity === 'medium' ? 'bg-amber-500/15 text-amber-400 border border-amber-500/20' : 'bg-slate-700 text-slate-400 border border-slate-600'}`}>
                {lim.severity.charAt(0).toUpperCase() + lim.severity.slice(1)}
              </span>
              <span class="badge bg-slate-800 text-slate-400 border border-slate-700">{lim.category}</span>
              {lim.affected.map(type => (
                <span class="badge bg-slate-800 text-slate-500 border border-slate-700">{type}</span>
              ))}
            </div>

            <h3 class="text-slate-100 font-semibold mb-3">{lim.title}</h3>

            <div class="grid sm:grid-cols-2 gap-4 text-sm">
              <div>
                <p class="text-slate-500 text-xs font-semibold uppercase tracking-wider mb-1">Problem</p>
                <p class="text-slate-400 leading-relaxed">{lim.problem}</p>
              </div>
              <div>
                <p class="text-teal-500 text-xs font-semibold uppercase tracking-wider mb-1">Workaround</p>
                <p class="text-slate-400 leading-relaxed">{lim.workaround}</p>
              </div>
            </div>

            <div class="mt-3 pt-3 border-t border-slate-800">
              <p class="text-slate-600 text-xs">
                <strong class="text-slate-500">Status:</strong> {lim.status}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Summary table -->
    <section class="mt-14">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">Quick Reference</h2>
      <div class="overflow-x-auto rounded-xl border border-slate-700">
        <table class="table-scientific">
          <thead>
            <tr><th>Limitation</th><th>Severity</th><th>Affected</th><th>Quick Fix</th></tr>
          </thead>
          <tbody>
            {limitations.map(lim => (
              <tr>
                <td>
                  <a href={`#${lim.id}`} class="text-slate-200 hover:text-teal-400 transition-colors text-sm">{lim.title}</a>
                </td>
                <td>
                  <span class={`text-xs ${lim.severity === 'high' ? 'text-red-400' : lim.severity === 'medium' ? 'text-amber-400' : 'text-slate-500'}`}>
                    {lim.severity}
                  </span>
                </td>
                <td class="text-slate-500 text-xs">{lim.affected[0]}{lim.affected.length > 1 ? ` +${lim.affected.length - 1}` : ''}</td>
                <td class="text-teal-500 text-xs">{lim.workaround.split('.')[0]}.</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="mt-12 flex gap-4">
      <a href="/tools/udb/validation/" class="btn-primary">Benchmarks</a>
      <a href="https://github.com/" target="_blank" rel="noopener noreferrer" class="btn-outline">Report an Issue ↗</a>
    </div>

  </div>
</Layout>
