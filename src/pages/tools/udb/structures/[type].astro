---
import Layout from '../../../../layouts/Layout.astro';
import MolViewer from '../../../../components/MolViewer.astro';
import MolViewerRuntime from '../../../../components/MolViewerRuntime.astro';
import { dendrimers, colorBadge, colorAccent } from '../../../../data/dendrimers';
import { getStructure, metricRows, mdRows, logRows, buildRows, formula,
         sourceLabel, isMinimised, seriesProvenance, ELEMENT_COLORS } from '../../../../data/structures';

export function getStaticPaths() {
  return dendrimers.map(d => ({ params: { type: d.id }, props: { d } }));
}

const { d } = Astro.props;
const struct = getStructure(d.id);

const allTypes = dendrimers.map(x => ({ id: x.id, name: x.name, color: x.color }));
const currentIdx = dendrimers.findIndex(x => x.id === d.id);
const prev = dendrimers[currentIdx - 1] ?? null;
const next = dendrimers[currentIdx + 1] ?? null;

const accentHex: Record<string, string> = {
  teal: '#2ce8d8', sky: '#38bdf8', amber: '#fbbf24', red: '#f87171',
  emerald: '#34d399', orange: '#fb923c', fuchsia: '#e879f9', violet: '#a78bfa',
};
const accent = accentHex[d.color] ?? '#2ce8d8';

const gens = struct?.generations ?? [];
const maxGen = gens.length ? gens[gens.length - 1].gen : null;
const bRows = buildRows(struct?.build);
// which parts of the series are AMBER-minimised vs published from as-built coords
const provenance = seriesProvenance(gens);
const anyAsBuilt = gens.some(g => !isMinimised(g));

// elements present across this family's structures (for the legend)
const elementsPresent = new Set<string>();
[struct?.core, struct?.monomer, ...gens].forEach(m => {
  if (m?.composition) Object.keys(m.composition).forEach(e => elementsPresent.add(e));
});
---

<Layout
  title={`${d.name} - ${d.full}`}
  description={`${d.name} (${d.full}) dendrimer - live interactive 3D of the full generation series (G1-G${maxGen ?? '?'}), core and monomer, with full characterization and build-log data.`}
  activeNav="tools"
>
  <MolViewerRuntime />

  <!-- Page header -->
  <div class="hud-veil py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-sm text-slate-500 mb-5 flex-wrap font-mono">
        <a href="/" class="hover:text-[var(--hud-cy)] transition-colors">Home</a><span class="text-slate-700">/</span>
        <a href="/tools/udb/" class="hover:text-[var(--hud-cy)] transition-colors">UDB</a><span class="text-slate-700">/</span>
        <a href="/tools/udb/structures/" class="hover:text-[var(--hud-cy)] transition-colors">Structure Gallery</a><span class="text-slate-700">/</span>
        <span style={`color:${accent}`}>{d.name}</span>
      </div>

      <div class="flex flex-col lg:flex-row lg:items-start gap-8">
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="hud-chip" style={`color:${accent};border-color:${accent}55`}>{d.name}</span>
            <span class="hud-chip">{d.full}</span>
            <span class="hud-chip">{d.coreLabel}</span>
          </div>
          <h1 class="hud-title text-4xl sm:text-5xl mb-3" style={`color:${accent}`}>{d.name}</h1>
          <p class="text-lg text-slate-300 font-semibold mb-3">{d.full}</p>
          <p class="text-slate-400 leading-relaxed max-w-2xl">{d.description}</p>
        </div>

        <div class="lg:w-80 shrink-0 hud-panel hud-corners rounded-2xl p-5 space-y-3">
          <h3 class="font-mono text-[11px] tracking-[0.2em] uppercase mb-3" style={`color:${accent}`}>// Quick Facts</h3>
          {[
            { label: 'Full name',   value: d.full },
            { label: 'Core',        value: d.coreLabel },
            { label: 'Force field', value: d.forceField },
            { label: 'Series',      value: maxGen ? `G1 - G${maxGen}` : '-' },
            { label: 'Geometry',    value: provenance || '-' },
          ].map(row => (
            <div class="flex flex-col gap-0.5">
              <span class="font-mono text-[10px] text-slate-500 uppercase tracking-wider">{row.label}</span>
              <span class="text-slate-200 text-sm">{row.value}</span>
            </div>
          ))}
          <div class="flex flex-col gap-0.5 pt-1">
            <span class="font-mono text-[10px] text-slate-500 uppercase tracking-wider">Chemistry</span>
            <span class="text-slate-400 text-xs leading-relaxed font-mono">{d.chemistry}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Type nav bar -->
  <div class="bg-[rgba(6,14,20,0.8)] border-b border-[var(--hud-line)] sticky top-16 z-40 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-x-auto">
      <div class="flex gap-1 py-2 min-w-max">
        {allTypes.map(t => (
          <a href={`/tools/udb/structures/${t.id}/`}
             class={`px-3 py-1.5 rounded-lg text-xs font-display font-semibold uppercase tracking-wider transition-colors ${
               t.id === d.id ? '' : 'text-slate-500 hover:text-slate-200'}`}
             style={t.id === d.id ? `color:${accentHex[t.color]};background:${accentHex[t.color]}18;border:1px solid ${accentHex[t.color]}44` : ''}>
            {t.name}
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-16">

    <!-- Building blocks: pure core + monomer -->
    <section>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
        <div>
          <p class="hud-eyebrow mb-3">Building Blocks</p>
          <h2 class="hud-title text-2xl sm:text-3xl">Core &amp; Monomer - Live 3D</h2>
          <p class="text-slate-400 text-sm mt-2 max-w-2xl">
            The pure initiator core and a single repeat unit, loaded from UDB's typed MOL2 output.
            Drag to rotate · scroll to zoom · click any atom to read its index &amp; element.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono shrink-0">
          <span class="text-slate-500">Atoms:</span>
          {[...elementsPresent].map(el => (
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full inline-block shrink-0" style={`background:${ELEMENT_COLORS[el] ?? '#aaa'};box-shadow:0 0 5px ${ELEMENT_COLORS[el] ?? '#aaa'}80`}></span>
              <span class="text-slate-300">{el}</span>
            </span>
          ))}
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {struct?.core && (
          <div>
            <MolViewer id={`${d.id}-core`} url={struct.core.file} height="320px" accent={accent} zoom={0.85}
              label="Initiator Core" sublabel={`${struct.core.n_atoms} atoms · ${formula(struct.core.composition)} · ${struct.core.mw?.toFixed(1)} Da`} />
          </div>
        )}
        {struct?.monomer && (
          <div>
            <MolViewer id={`${d.id}-monomer`} url={struct.monomer.file} height="320px" accent={accent} zoom={0.85}
              label="Repeat Unit (Monomer)" sublabel={`${struct.monomer.n_atoms} atoms · ${formula(struct.monomer.composition)} · ${struct.monomer.mw?.toFixed(1)} Da`} />
          </div>
        )}
      </div>
    </section>

    <!-- Build parameters (from UDB build log) -->
    {bRows.length > 0 && (
      <section class="hud-panel hud-corners rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
          <div>
            <p class="hud-eyebrow mb-2">Build Recipe</p>
            <h2 class="hud-title text-2xl sm:text-3xl">How UDB Assembled This Family</h2>
          </div>
          <span class="font-mono text-[10px] text-slate-500 uppercase tracking-wider">
            {struct?.build?.force_field ?? 'GAFF2'} · {struct?.build?.parameterization ?? 'Fragment BCC'}
          </span>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-0">
          {bRows.map(r => (
            <div class="flex items-baseline justify-between gap-3 py-2 border-b border-[var(--hud-line-soft)]">
              <span class="font-mono text-[11px] text-slate-500">{r.label}</span>
              <span class="font-mono text-[11px] text-slate-200 text-right">
                {r.value}{r.note && <span class="text-slate-500"> · {r.note}</span>}
              </span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Generation series: live minimised structures + full characterization -->
    <section>
      <p class="hud-eyebrow mb-3">Generation Series</p>
      <h2 class="hud-title text-2xl sm:text-3xl">{maxGen ? `G1 - G${maxGen} Structures` : 'Structures'}</h2>
      <p class="text-slate-400 text-sm mt-2 mb-8 max-w-3xl">
        Every generation UDB produced for this family, at the best geometry available to it:
        <span class="text-slate-300">{provenance}</span>.
        {anyAsBuilt && ' Generations beyond the AMBER minimisation run are shown from UDB\'s as-built coordinates (Fibonacci placement + collective minimisation), which are the same coordinates written to the released PDB.'}
        All metrics below are computed by UDB's characterization module directly from the coordinates shown.
      </p>

      <div class="space-y-6">
        {gens.map(g => {
          const rows = metricRows(g);
          const mRows = mdRows(g.md);
          const lRows = logRows(g.log);
          const minimised = isMinimised(g);
          const srcTag = sourceLabel(g);
          return (
            <div class="hud-panel hud-corners rounded-2xl p-5 sm:p-6">
              <div class="grid lg:grid-cols-[minmax(0,1fr)_1.25fr] gap-6 items-start">
                <!-- live viewer -->
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class="font-hud text-2xl font-bold" style={`color:${accent}`}>{d.name} G{g.gen}</span>
                    <div class="flex items-center gap-2">
                      {srcTag && (
                        <span class="hud-chip" style={minimised ? `color:${accent};border-color:${accent}55` : 'color:#94a3b8'}>
                          {srcTag}
                        </span>
                      )}
                      <span class="hud-chip">{g.n_atoms.toLocaleString()} atoms</span>
                    </div>
                  </div>
                  <MolViewer id={`${d.id}-g${g.gen}`} url={g.file} height="360px" accent={accent} zoom={0.92} />
                </div>

                <!-- characterization data -->
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class="font-mono text-[11px] tracking-[0.2em] uppercase" style={`color:${accent}`}>// Characterization</span>
                    <span class="font-mono text-[10px] text-slate-500">
                      {struct?.build?.force_field ?? 'GAFF2'} · Fragment BCC · {minimised ? 'minimised' : 'as built'}
                    </span>
                  </div>
                  <!-- composition chips -->
                  {g.composition && (
                    <div class="flex flex-wrap gap-2 mb-4">
                      {Object.entries(g.composition).map(([el, n]) => (
                        <span class="flex items-center gap-1.5 font-mono text-[11px] px-2 py-1 rounded border border-[var(--hud-line)]">
                          <span class="w-2.5 h-2.5 rounded-full" style={`background:${ELEMENT_COLORS[el] ?? '#aaa'}`}></span>
                          <span class="text-slate-200">{el}</span><span class="text-slate-500">{n}</span>
                        </span>
                      ))}
                    </div>
                  )}
                  <div class="grid sm:grid-cols-2 gap-x-6 gap-y-0">
                    {rows.map(r => (
                      <div class="flex items-baseline justify-between gap-3 py-1.5 border-b border-[var(--hud-line-soft)]">
                        <span class="font-mono text-[11px] text-slate-500">{r.label}</span>
                        <span class="font-mono text-[11px] text-slate-200 text-right">
                          {r.value}{r.note && <span class="text-slate-500"> · {r.note}</span>}
                        </span>
                      </div>
                    ))}
                  </div>

                  {lRows.length > 0 && (
                    <div class="mt-5 pt-4 border-t border-[var(--hud-line)]">
                      <span class="font-mono text-[11px] tracking-[0.2em] uppercase text-slate-400 block mb-2">// Build Record</span>
                      <div class="grid sm:grid-cols-2 gap-x-6 gap-y-0">
                        {lRows.map(r => (
                          <div class="flex items-baseline justify-between gap-3 py-1.5 border-b border-[var(--hud-line-soft)]">
                            <span class="font-mono text-[11px] text-slate-500">{r.label}</span>
                            <span class="font-mono text-[11px] text-slate-200 text-right">
                              {r.value}{r.note && <span class="text-slate-500"> · {r.note}</span>}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {mRows.length > 0 && (
                    <div class="mt-5 pt-4 border-t border-[var(--hud-line)]">
                      <span class="font-mono text-[11px] tracking-[0.2em] uppercase text-slate-400 block mb-2">// MD Simulation Setup</span>
                      <div class="grid sm:grid-cols-2 gap-x-6 gap-y-0">
                        {mRows.map(r => (
                          <div class="flex items-baseline justify-between gap-3 py-1.5 border-b border-[var(--hud-line-soft)]">
                            <span class="font-mono text-[11px] text-slate-500">{r.label}</span>
                            <span class="font-mono text-[11px] text-slate-200 text-right">
                              {r.value}{r.note && <span class="text-slate-500"> · {r.note}</span>}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Applications -->
    <section class="hud-panel hud-corners rounded-2xl p-6">
      <h2 class="font-display text-slate-100 font-bold text-lg mb-3">Applications</h2>
      <p class="text-slate-400 leading-relaxed">{d.applications}</p>
    </section>

  </div>

  <!-- Prev / Next -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <div class="flex items-center justify-between gap-4 pt-8 border-t border-[var(--hud-line)]">
      <div>
        {prev && (
          <a href={`/tools/udb/structures/${prev.id}/`} class="flex items-center gap-2 text-slate-400 hover:text-[var(--hud-cy)] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            <span class="text-sm">{prev.name}</span>
          </a>
        )}
      </div>
      <a href="/tools/udb/structures/" class="font-mono text-slate-500 hover:text-[var(--hud-cy)] text-sm transition-colors">ALL TYPES ↑</a>
      <div>
        {next && (
          <a href={`/tools/udb/structures/${next.id}/`} class="flex items-center gap-2 text-slate-400 hover:text-[var(--hud-cy)] transition-colors">
            <span class="text-sm">{next.name}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        )}
      </div>
    </div>
  </div>

</Layout>
