---
import Layout from '../../../../layouts/Layout.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import { dendrimers, colorBadge, colorAccent, colorBorder, colorGlow } from '../../../../data/dendrimers';
---

<Layout title="Structure Gallery" description="Avogadro-rendered molecular structures for all 7 UDB dendrimer types, with individual pages for generation series, interactive 3D viewers, and building block analysis." activeNav="tools">

  <!-- Header -->
  <PageHeader
    title="Structure Gallery"
    description="Seven dendrimer families supported by UDB v1.0, each with Avogadro-rendered generation series, interactive 3D building-block viewers, chemistry, and applications."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'UDB', href: '/tools/udb/' }, { label: 'Structure Gallery' }]}
  />

  <!-- All-types comparison banner -->
  <div class="bg-slate-900/60 border-b border-slate-800">
    <div class="reveal reveal-up max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <p class="mono text-sky-500 text-xs tracking-widest uppercase mb-3 text-center">All 7 Types at G3: Avogadro Renders</p>
      <div class="rounded-2xl overflow-hidden border border-slate-700">
        <img src="/images/ai-dendrimer-comparison.png" alt="All 7 dendrimer types compared at Generation 3" class="w-full" />
      </div>
    </div>
  </div>

  <!-- Type cards grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <p class="reveal reveal-up mono text-sky-500 text-xs tracking-widest uppercase mb-8 text-center">Select a Dendrimer Type</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {dendrimers.map((d, i) => (
        <a
          href={`/tools/udb/structures/${d.id}/`}
          class={`reveal reveal-up reveal-delay-${(i % 4) + 1} group relative rounded-2xl border bg-slate-900/60 overflow-hidden transition-all duration-300 hover:shadow-[0_0_40px_var(--glow)] hover:-translate-y-1 ${colorBorder[d.color]}`}
          style={`--glow: ${colorGlow[d.color]}`}
        >
          <!-- Preview image (G3 or highest available) -->
          <div class="aspect-square bg-black overflow-hidden">
            <img
              src={d.generations[Math.min(2, d.generations.length - 1)].src}
              alt={`${d.name} ${d.generations[Math.min(2, d.generations.length - 1)].gen}`}
              class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>

          <!-- Info -->
          <div class="p-5">
            <div class="flex flex-wrap gap-1.5 mb-3">
              <span class={`badge border text-xs ${colorBadge[d.color]}`}>{d.name}</span>
              <span class="badge bg-slate-800 text-slate-500 border border-slate-700 text-xs mono">{d.coreLabel}</span>
            </div>
            <h2 class={`font-bold text-base mb-1 ${colorAccent[d.color]}`}>{d.name}</h2>
            <p class="text-slate-500 text-xs mb-3">{d.full}</p>
            <p class="text-slate-400 text-xs leading-relaxed line-clamp-3">{d.description}</p>

            <div class="mt-4 flex items-center gap-1.5 text-xs">
              <span class="text-slate-500">{d.generations.length} generations rendered</span>
              <span class="text-slate-700">·</span>
              <span class="text-slate-500">3D viewer</span>
            </div>
          </div>

          <!-- Arrow -->
          <div class={`absolute top-4 right-4 w-7 h-7 rounded-full border flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity ${colorBadge[d.color]} border-current`}>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-14 flex gap-4">
      <a href="/tools/udb/examples/" class="btn-outline">← Worked Examples</a>
      <a href="/tools/udb/validation/" class="btn-primary">Benchmarks →</a>
    </div>
  </div>

</Layout>
