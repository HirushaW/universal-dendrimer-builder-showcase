---

<Layout title="Structure Gallery" description="Avogadro-rendered molecular structures for all 7 UDB dendrimer types across generations G1–G5, with interactive 3D monomer and core viewers." activeNav="tools">

  <!-- Header -->
  <div class="bg-gradient-to-br from-slate-950 to-slate-900 border-b border-slate-800 py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-sm text-slate-500 mb-4">
        <a href="/" class="hover:text-teal-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/tools/udb/" class="hover:text-teal-400 transition-colors">UDB</a>
        <span>/</span>
        <span class="text-slate-300">Structure Gallery</span>
      </div>
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Structure Gallery</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Avogadro-rendered molecular structures for all 7 supported dendrimer types across
        G1–G5, with interactive 3D views of the monomer and core building blocks from the actual UDB output files.
      </p>
    </div>
  </div>

  <!-- Comparison banner -->
  <div class="bg-slate-900/60 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <p class="mono text-teal-500 text-xs tracking-widest uppercase mb-3 text-center">All Types at G3</p>
      <div class="rounded-2xl overflow-hidden border border-slate-700">
        <img src="/images/ai-dendrimer-comparison.png" alt="All 7 dendrimer types compared at Generation 3" class="w-full" />
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-20">

    {dendrimers.map(d => (
      <section id={d.id}>
        <!-- Type header -->
        <div class="flex flex-col sm:flex-row sm:items-start gap-4 mb-8">
          <div class="flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class={`badge border ${colorBadge[d.color]}`}>{d.name}</span>
              <span class="badge bg-slate-800 text-slate-400 border border-slate-700">{d.full}</span>
              <span class="badge bg-slate-800 text-slate-500 border border-slate-700 mono text-xs">{d.core}</span>
            </div>
            <h2 class={`text-2xl font-bold mb-2 ${colorAccent[d.color]}`}>{d.name} — {d.full}</h2>
            <p class="text-slate-400 text-sm leading-relaxed max-w-2xl">{d.description}</p>
          </div>
        </div>

        <!-- Generation series -->
        <div class="mb-8">
          <h3 class="text-slate-300 font-semibold text-sm mb-4 uppercase tracking-wider">Generation Series — Avogadro Renders</h3>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            {d.generations.map(g => (
              <div class={`rounded-2xl overflow-hidden border bg-black transition-all duration-300 ${colorBorder[d.color]}`}>
                <img
                  src={g.src}
                  alt={`${d.name} ${g.gen} — Avogadro minimized structure, ${g.atoms} atoms`}
                  class="w-full"
                  loading="lazy"
                />
                <div class="px-3 py-2.5 bg-slate-950/80">
                  <div class={`font-bold text-sm ${colorAccent[d.color]}`}>{d.name} {g.gen}</div>
                  <div class="mono text-slate-500 text-xs">{g.atoms} atoms</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 3D viewer section -->
        <div class="bg-slate-900/60 rounded-2xl border border-slate-700 p-6">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"/>
            </svg>
            <h3 class="text-slate-200 font-semibold text-sm">Building Blocks — Interactive 3D (from UDB output files)</h3>
          </div>
          <Mol2Viewer id={d.id} monomerUrl={d.monomerUrl} coreUrl={d.coreUrl} />
        </div>
      </section>
    ))}

  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14 flex gap-4">
    <a href="/tools/udb/examples/" class="btn-outline">← Worked Examples</a>
    <a href="/tools/udb/validation/" class="btn-primary">Benchmarks →</a>
  </div>

</Layout>

<!-- 3Dmol.js -->
<script is:inline src="https://3dmol.org/build/3Dmol-min.js"></script>
<script is:inline>
(async function () {
  if (typeof $3Dmol === 'undefined') return;

  const pairs = document.querySelectorAll('.mol2-viewer-pair');

  for (const pair of pairs) {
    const monomerUrl = pair.dataset.monomer;
    const coreUrl    = pair.dataset.core;
    const id         = pair.dataset.id;

    async function initViewer(containerId, url) {
      const el = document.getElementById(containerId);
      if (!el) return;

      try {
        const data = await fetch(url).then(r => r.text());
        const loading = el.querySelector('.viewer-loading');
        if (loading) loading.remove();

        const viewer = $3Dmol.createViewer(el, {
          backgroundColor: '#0b1221',
          antialias: true,
        });

        viewer.addModel(data, 'mol2');
        viewer.setStyle({}, {
          stick:  { colorscheme: 'Jmol', radius: 0.12 },
          sphere: { colorscheme: 'Jmol', scale: 0.22 },
        });
        viewer.zoomTo();
        viewer.render();
      } catch (e) {
        const el2 = document.getElementById(containerId);
        if (el2) el2.innerHTML = '<p class="text-slate-500 text-xs text-center p-4">Failed to load structure</p>';
      }
    }

    initViewer(`viewer-${id}-monomer`, monomerUrl);
    initViewer(`viewer-${id}-core`,    coreUrl);
  }
})();
</script>
