---
import Layout from '../../../../layouts/Layout.astro';
import MolViewer from '../../../../components/MolViewer.astro';
import MolViewerRuntime from '../../../../components/MolViewerRuntime.astro';
import { dendrimers, colorAccent } from '../../../../data/dendrimers';
import { getStructure, formula } from '../../../../data/structures';

const accentHex: Record<string, string> = {
  teal: '#2ce8d8', sky: '#38bdf8', amber: '#fbbf24', red: '#f87171',
  emerald: '#34d399', orange: '#fb923c', fuchsia: '#e879f9',
};

// pick a representative minimised generation for each type's card
const cards = dendrimers.map(d => {
  const s = getStructure(d.id);
  const gens = s?.generations ?? [];
  const rep = gens.length ? gens[Math.min(2, gens.length - 1)] : null;
  return { d, s, rep, maxGen: gens.length ? gens[gens.length - 1].gen : null };
});
---

<Layout title="Structure Gallery" description="Live interactive 3D of all 7 UDB dendrimer families - AMBER-minimised generation series, core and monomer viewers, and full characterization data." activeNav="tools">
  <MolViewerRuntime />

  <!-- Header -->
  <div class="hud-veil py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-sm text-slate-500 mb-4 font-mono">
        <a href="/" class="hover:text-[var(--hud-cy)] transition-colors">Home</a><span class="text-slate-700">/</span>
        <a href="/tools/udb/" class="hover:text-[var(--hud-cy)] transition-colors">UDB</a><span class="text-slate-700">/</span>
        <span class="text-slate-300">Structure Gallery</span>
      </div>
      <p class="hud-eyebrow mb-3">Interactive 3D Library</p>
      <h1 class="hud-title text-4xl sm:text-5xl mb-3">Structure Gallery</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Seven dendrimer families - each with a live, rotatable AMBER-minimised generation
        series, core &amp; monomer viewers, and full characterization data. Every structure
        is loaded from real UDB output. Drag to rotate · scroll to zoom · click atoms to inspect.
      </p>
    </div>
  </div>

  <!-- Type cards grid with live viewers -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <p class="hud-eyebrow justify-center mb-8" style="justify-content:center">Select a dendrimer family</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map(({ d, rep, maxGen }) => {
        const accent = accentHex[d.color] ?? '#2ce8d8';
        return (
          <div class="hud-panel hud-corners rounded-2xl overflow-hidden flex flex-col">
            {rep ? (
              <MolViewer id={`gal-${d.id}`} url={rep.file} height="260px" accent={accent} spin={true} zoom={0.85} />
            ) : (
              <div class="h-[260px] flex items-center justify-center text-slate-600 font-mono text-xs">no structure</div>
            )}
            <div class="p-5 flex flex-col flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="hud-chip" style={`color:${accent};border-color:${accent}55`}>{d.name}</span>
                <span class="hud-chip">{d.coreLabel}</span>
              </div>
              <h2 class="font-display font-bold text-lg mb-1" style={`color:${accent}`}>{d.full}</h2>
              {rep && <p class="font-mono text-[10px] text-slate-500 mb-3">Showing G{rep.gen} · {rep.n_atoms.toLocaleString()} atoms · {formula(rep.composition)}</p>}
              <p class="text-slate-400 text-xs leading-relaxed line-clamp-3 flex-1">{d.description}</p>
              <div class="mt-4 flex items-center justify-between">
                <span class="font-mono text-[10px] text-slate-500">{maxGen ? `G1-G${maxGen} series` : ''}</span>
                <a href={`/tools/udb/structures/${d.id}/`}
                   class="inline-flex items-center gap-1.5 font-display text-xs font-semibold uppercase tracking-wider transition-transform hover:translate-x-0.5"
                   style={`color:${accent}`}>
                  Open <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-14 flex gap-4">
      <a href="/tools/udb/manual/" class="btn-outline">← User Manual</a>
      <a href="/tools/udb/validation/" class="btn-primary">Benchmarks →</a>
    </div>
  </div>

</Layout>
