---
import Layout from '../../../../layouts/Layout.astro';

const examples = [
  {
    id: 'pamam-g3',
    type: 'PAMAM',
    generation: 'G3',
    title: 'PAMAM G3 — Start to NAMD Trajectory',
    time: '~15 min total',
    atoms: '516',
    screenshot: '/images/gui-pamam.png',
    screenshotAlt: 'UDB v1.0 GUI — PAMAM G6 build complete with generation preview table',
    structure: '/images/real-pamam-g3.png',
    structureAlt: 'Avogadro render of PAMAM G3 minimized structure',
    forceField: 'GAFF2 + BCC',
    summary: 'Full walkthrough: build a PAMAM G3 dendrimer with EDA core, parameterize with Fragment BCC / GAFF2, solvate in TIP3P water, and run a 1 ns NAMD trajectory.',
    steps: [
      'Select PAMAM, Generation G3 in the left panel',
      'Build tab → Build Structure → 516 atoms expected',
      'Parameterize tab → GAFF2 + Fragment BCC → Run Parameterization',
      'Verify .prmtop and .inpcrd in output directory',
      'MD Setup → 12 Å padding, 0.15 M NaCl, 1 ns, 300 K',
      'Generate NAMD Input → review namd.conf',
      'Run: namd3 +p4 namd.conf > run.log',
      'Characterize tab → Load trajectory → Compute Rg, SASA',
    ],
    expectedOutputs: ['dendrimer.mol2 (516 atoms)', 'dendrimer.prmtop', 'solvated.psf / solvated.pdb', 'namd.conf', 'trajectory.dcd'],
    timing: 'Build: ~5 s | Param: ~3 min | NAMD 1 ns: ~2–4 h (4 cores)',
  },
  {
    id: 'carbosilane',
    type: 'Carbosilane',
    generation: 'G2',
    title: 'Carbosilane G2 — Manual GAFF2 Bypass',
    time: '~20 min total',
    atoms: '~280',
    screenshot: '/images/gui-carbosilane.png',
    screenshotAlt: 'UDB v1.0 GUI — Carbosilane G6 build complete with generation preview table',
    structure: '/images/real-carbosilane-g2.png',
    structureAlt: 'Avogadro render of Carbosilane G2 minimized structure',
    forceField: 'GAFF2 manual bypass',
    summary: 'Carbosilane dendrimers contain silicon — CGenFF is incompatible. This example shows the manual GAFF2 bypass procedure for Si-containing branches.',
    steps: [
      'Select Carbosilane, Generation G2',
      'Build tab → Build Structure',
      'Parameterize tab → Force Field dropdown → select GAFF2 (manual)',
      'Uncheck "Auto-detect CGenFF for heteroatoms"',
      'Run Parameterization → check .frcmod for Si parameters',
      'Verify no penalty >200 in parameterization log',
      'Continue to MD Setup as normal',
    ],
    expectedOutputs: ['carbosilane_g2.mol2', 'carbosilane_g2.frcmod (with Si params)', 'carbosilane_g2.prmtop'],
    timing: 'Build: ~3 s | Param: ~5 min (manual verification needed)',
  },
  {
    id: 'phosphorus',
    type: 'Phosphorus',
    generation: 'G3',
    title: 'Phosphorus G3 — Gasteiger + UFF',
    time: '~25 min total',
    atoms: '~650',
    screenshot: '/images/gui-phosphorus.png',
    screenshotAlt: 'UDB v1.0 GUI — Phosphorus G6 build complete with generation preview table',
    structure: '/images/real-phosphorus-g3.png',
    structureAlt: 'Avogadro render of Phosphorus G3 minimized structure',
    forceField: 'Gasteiger + UFF',
    summary: 'High-generation Phosphorus dendrimers may exceed BCC bond limits. This example demonstrates the Gasteiger charge fallback with UFF parameters.',
    steps: [
      'Select Phosphorus, Generation G3',
      'Build tab → Build Structure',
      'Parameterize tab → Charge Method → Gasteiger',
      'Force Field → GAFF2 + UFF for P-core',
      'Run Parameterization',
      'Inspect .frcmod — UFF parameters substituted for any missing P terms',
    ],
    expectedOutputs: ['phosphorus_g3.mol2', 'phosphorus_g3_gasteiger.frcmod', 'phosphorus_g3.prmtop'],
    timing: 'Build: ~10 s | Param: ~4 min',
  },
  {
    id: 'ppi',
    type: 'PPI',
    generation: 'G4',
    title: 'PPI G4 — Standard Workflow',
    time: '~15 min total',
    atoms: '~1400',
    screenshot: '/images/gui-ppi.png',
    screenshotAlt: 'UDB v1.0 GUI — PPI G6 build complete with generation preview table',
    structure: '/images/real-ppi-g4.png',
    structureAlt: 'Avogadro render of PPI G4 minimized structure',
    forceField: 'GAFF2 + CGenFF',
    summary: 'PPI dendrimers use a DAB (1,4-diaminobutane) core with tertiary amine branching. This example shows a standard G4 build and parameterization.',
    steps: [
      'Select PPI, Generation G4',
      'Build tab → Build Structure → ~1400 atoms expected',
      'Parameterize tab → GAFF2 + CGenFF (auto) → Run',
      'MD Setup → 15 Å padding (larger box for G4)',
    ],
    expectedOutputs: ['ppi_g4.mol2', 'ppi_g4.prmtop', 'namd_ppi_g4.conf'],
    timing: 'Build: ~8 s | Param: ~5 min | NAMD 1 ns: ~4–8 h (4 cores)',
  },
];
---

<Layout title="Worked Examples" description="UDB worked examples — end-to-end walkthroughs for PAMAM, Carbosilane, Phosphorus, and PPI dendrimers." activeNav="tools">

  <div class="bg-gradient-to-br from-slate-950 to-slate-900 border-b border-slate-800 py-14">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-sm text-slate-500 mb-4">
        <a href="/" class="hover:text-teal-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/tools/udb/" class="hover:text-teal-400 transition-colors">UDB</a>
        <span>/</span>
        <span class="text-slate-300">Examples</span>
      </div>
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Worked Examples</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        End-to-end walkthroughs covering one example per major dendrimer type.
        Each includes step-by-step instructions, expected outputs, and timing on reference hardware.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">

    <!-- Gallery link note -->
    <div class="mb-10 p-4 rounded-xl bg-teal-500/5 border border-teal-500/20 flex items-center justify-between gap-4">
      <p class="text-teal-300 text-sm">
        Looking for rendered structures across all dendrimer types and generations?
      </p>
      <a href="/tools/udb/structures/" class="btn-primary shrink-0 text-sm">Structure Gallery →</a>
    </div>

    <!-- Example list -->
    <div class="space-y-10">
      {examples.map(ex => (
        <div id={ex.id} class="bg-slate-900 rounded-2xl border border-slate-700 overflow-hidden">
          <!-- Header -->
          <div class="p-6 border-b border-slate-700 flex flex-col sm:flex-row sm:items-start gap-4">
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="badge bg-teal-500/10 text-teal-400 border border-teal-500/20">{ex.type}</span>
                <span class="badge bg-slate-800 text-slate-300 border border-slate-700">{ex.generation}</span>
                <span class="badge bg-slate-800 text-slate-400 border border-slate-700">{ex.forceField}</span>
                <span class="badge bg-teal-500/10 text-teal-400 border border-teal-500/20">GUI Screenshot</span>
              </div>
              <h2 class="text-xl font-bold text-slate-100 mb-1">{ex.title}</h2>
              <p class="text-slate-400 text-sm leading-relaxed">{ex.summary}</p>
            </div>
            <div class="text-right shrink-0">
              <div class="text-teal-400 font-bold">{ex.time}</div>
              <div class="text-slate-500 text-xs">{ex.atoms} atoms</div>
            </div>
          </div>

          <div class="p-6 grid md:grid-cols-2 gap-6">
            <!-- Steps -->
            <div>
              <h3 class="text-slate-300 font-semibold text-sm mb-3">Steps</h3>
              <ol class="space-y-2">
                {ex.steps.map((step, i) => (
                  <li class="flex gap-3 text-sm">
                    <span class="text-teal-500/60 font-mono text-xs w-5 shrink-0 pt-0.5">{i + 1}.</span>
                    <span class="text-slate-400">{step}</span>
                  </li>
                ))}
              </ol>
            </div>

            <!-- Expected outputs + timing -->
            <div class="space-y-5">
              <div>
                <h3 class="text-slate-300 font-semibold text-sm mb-3">Expected Outputs</h3>
                <ul class="space-y-1.5">
                  {ex.expectedOutputs.map(out => (
                    <li class="flex items-center gap-2 text-xs">
                      <svg class="w-3.5 h-3.5 text-teal-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                      </svg>
                      <code class="text-teal-300 font-mono">{out}</code>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h3 class="text-slate-300 font-semibold text-sm mb-2">Timing Reference</h3>
                <p class="text-slate-500 text-xs font-mono leading-relaxed">{ex.timing}</p>
              </div>
              <div class="space-y-3">
                <div>
                  <p class="text-slate-400 text-xs font-medium mb-1.5 uppercase tracking-wider">GUI — Build Output</p>
                  <img src={ex.screenshot} alt={ex.screenshotAlt} class="w-full rounded-lg border border-slate-700" />
                </div>
                <div>
                  <p class="text-slate-400 text-xs font-medium mb-1.5 uppercase tracking-wider">Minimized Structure (Avogadro)</p>
                  <img src={ex.structure} alt={ex.structureAlt} class="w-full rounded-lg border border-slate-700 bg-black" />
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 flex gap-4">
      <a href="/tools/udb/manual/" class="btn-outline">← User Manual</a>
      <a href="/tools/udb/validation/" class="btn-primary">Benchmarks →</a>
    </div>

  </div>
</Layout>
