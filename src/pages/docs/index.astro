---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const sections = [
  {
    title: 'Getting Started',
    links: [
      { href: '/tools/udb/install/', label: 'Installation Guide', desc: 'Conda setup, AmberTools25, NAMD 3.x, Python dependencies' },
      { href: '/tools/udb/manual/#getting-started', label: 'First Steps', desc: 'Launch UDB and build your first dendrimer in minutes' },
    ],
  },
  {
    title: 'UDB Reference',
    links: [
      { href: '/tools/udb/manual/', label: 'User Manual', desc: 'Complete tab-by-tab reference with all parameters' },
      { href: '/tools/udb/manual/#theory', label: 'Theory & Algorithms', desc: 'Seven-stage placement engine, SA, Fragment BCC' },
      { href: '/tools/udb/manual/#parameters', label: 'Key Parameters', desc: 'Default values and tuning guide' },
      { href: '/tools/udb/manual/#outputs', label: 'Output Files', desc: 'All files generated by UDB, by stage' },
    ],
  },
  {
    title: 'Examples & Validation',
    links: [
      { href: '/tools/udb/examples/', label: 'Worked Examples', desc: 'End-to-end walkthroughs for PAMAM, Carbosilane, PPI, Phosphorus' },
      { href: '/tools/udb/validation/', label: 'Benchmarks', desc: 'Atom counts and shape descriptors vs. Maiti 2004' },
    ],
  },
  {
    title: 'Troubleshooting',
    links: [
      { href: '/tools/udb/install/#known-issues', label: 'Install Issues', desc: 'AVX512, conda activation, antechamber MAXBOND' },
    ],
  },
  {
    title: 'Project Info',
    links: [
      { href: '/tools/udb/changelog/', label: 'Changelog', desc: 'Version history and feature notes' },
      { href: '/about/', label: 'About & Contact', desc: 'Author, institution, citation, GitHub' },
    ],
  },
];
---

<Layout title="Documentation" description="UDB documentation index: manuals, examples, benchmarks, and reference materials." activeNav="docs">

  <PageHeader
    title="Documentation"
    description="Everything you need to install, use, and understand UDB. Start with the Install guide or jump straight to Worked Examples."
  >
    <Fragment slot="actions">
      <a href="/tools/udb/install/" class="btn-primary">Install Guide</a>
      <a href="/tools/udb/examples/" class="btn-outline">Examples</a>
    </Fragment>
  </PageHeader>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">

    <!-- Quick nav -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-14">
      {[
        { href: '/tools/udb/install/', title: 'Install', icon: '↓', color: 'teal' },
        { href: '/tools/udb/manual/', title: 'Manual', icon: '📖', color: 'sky' },
        { href: '/tools/udb/examples/', title: 'Examples', icon: '▶', color: 'violet' },
        { href: '/tools/udb/validation/', title: 'Benchmarks', icon: '✓', color: 'emerald' },
        { href: '/tools/udb/changelog/', title: 'Changelog', icon: '📋', color: 'slate' },
      ].map((card, i) => (
        <a href={card.href} class={`reveal reveal-up reveal-delay-${(i % 3) + 1} card card-sheen group flex items-center gap-3`}>
          <span class="text-2xl">{card.icon}</span>
          <span class="text-slate-200 font-semibold group-hover:text-sky-400 transition-colors">{card.title} →</span>
        </a>
      ))}
    </div>

    <!-- Full index -->
    <div class="space-y-10">
      {sections.map(section => (
        <div class="reveal reveal-up">
          <h2 class="text-xl font-bold text-slate-200 mb-4 pb-2 border-b border-slate-800">{section.title}</h2>
          <div class="grid sm:grid-cols-2 gap-3">
            {section.links.map(link => (
              <a href={link.href} class="flex flex-col p-4 bg-slate-900 rounded-xl border border-slate-800 hover:border-sky-500/40 hover:bg-slate-800/50 transition-colors group">
                <span class="text-slate-200 font-medium text-sm group-hover:text-sky-400 transition-colors mb-1">{link.label}</span>
                <span class="text-slate-500 text-xs leading-relaxed">{link.desc}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Future tools placeholder -->
    <div class="mt-14 p-6 rounded-2xl border-2 border-dashed border-slate-800">
      <h2 class="text-lg font-bold text-slate-600 mb-2">Future Tools</h2>
      <p class="text-slate-600 text-sm">
        This documentation index is designed to accommodate additional computational tools
        (e.g., a COF builder) as they become available. Each new tool will appear as a
        new section here without requiring a site redesign.
      </p>
    </div>

  </div>
</Layout>
