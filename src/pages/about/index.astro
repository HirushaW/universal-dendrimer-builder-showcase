---
import Layout from '../../layouts/Layout.astro';
import CitationBlock from '../../components/CitationBlock.astro';
import PageHeader from '../../components/PageHeader.astro';
---

<Layout title="About" description="About Hirusha Walgampaya and the Universal Dendrimer Builder project at University of Peradeniya." activeNav="about">

  <PageHeader
    title="About"
    description="The Universal Dendrimer Builder and its author."
  />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-14">

    <!-- Author section -->
    <section class="reveal reveal-up grid sm:grid-cols-3 gap-8">
      <div class="sm:col-span-1 flex flex-col items-center sm:items-start gap-4">
        <img
          src="/images/profile.jpg"
          alt="Hirusha Walgampaya"
          class="w-32 h-32 rounded-2xl object-cover border border-slate-700 shadow-lg"
          width="128" height="128"
        />
        <!-- Contact links -->
        <div class="space-y-2 w-full">
          <a
            href="mailto:hiruwalgampaya@gmail.com"
            class="flex items-center gap-2.5 text-sm text-slate-400 hover:text-teal-400 transition-colors"
          >
            <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            hiruwalgampaya@gmail.com
          </a>
          <a
            href="https://github.com/HirushaW/universal-dendrimer-builder"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 text-sm text-slate-400 hover:text-teal-400 transition-colors"
          >
            <svg class="w-4 h-4 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
            GitHub
          </a>
        </div>
      </div>

      <!-- Bio -->
      <div class="sm:col-span-2">
        <h2 class="text-2xl font-bold text-slate-100 mb-1">Hirusha Walgampaya</h2>
        <p class="text-teal-400 font-medium mb-1">Computational Chemistry Researcher</p>
        <p class="text-slate-500 text-sm mb-5">
          Undergraduate, Faculty of Science · University of Peradeniya, Sri Lanka
        </p>
        <div class="space-y-3 text-slate-400 leading-relaxed">
          <p>
            Hirusha Walgampaya is a computational chemistry undergraduate researcher at the
            University of Peradeniya, with a focus on nanoscale molecular simulation and
            force-field development for complex macromolecular systems.
          </p>
          <p>
            The Universal Dendrimer Builder emerged from hands-on work with dendrimer
            simulation workflows: building structures, debugging antechamber failures,
            tracking down NAMD binary incompatibilities, and adapting published protocols
            to local HPC infrastructure. The recurring cost of reinventing these steps
            motivated a unified tool.
          </p>
          <p>
            UDB is an open-source project intended to be useful to anyone building
            dendrimer simulation systems, from undergraduates running their first MD
            calculation to senior researchers needing reproducible structure generation
            at scale.
          </p>
        </div>
      </div>
    </section>

    <!-- About the project -->
    <section class="reveal reveal-up">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">About the Project</h2>
      <div class="space-y-3 text-slate-400 leading-relaxed">
        <p>
          UDB v1.0 is the first public release of a project that has been through several internal
          iterations (earlier development versions). The v1.0 designation marks the point at which
          the tool is feature-stable, validated against published data, and documented well enough
          for external use.
        </p>
        <p>
          The project is designed as the first of potentially several related computational tools.
          The site structure accommodates future additions (e.g., a COF builder) without
          requiring a redesign.
        </p>
        <p>
          UDB is not affiliated with CHARMM-GUI, AmberTools, or NAMD. It is an independent
          tool that calls these packages as external dependencies.
        </p>
      </div>
    </section>

    <!-- Affiliation -->
    <section class="reveal reveal-up">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">Institution</h2>
      <div class="p-5 bg-slate-900 rounded-xl border border-slate-700">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
          </div>
          <div>
            <h3 class="text-slate-100 font-semibold">University of Peradeniya</h3>
            <p class="text-slate-500 text-sm">Faculty of Science, Department of Chemistry</p>
            <p class="text-slate-500 text-sm">Peradeniya, Sri Lanka</p>
            <p class="text-slate-600 text-xs mt-2">
              [Lab group / supervisor details to be added when confirmed]
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Open questions / disclaimers -->
    <section class="reveal reveal-up">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">Acknowledgements</h2>
      <div class="p-5 bg-slate-900 rounded-xl border border-slate-700 text-slate-400 text-sm leading-relaxed">
        <p class="text-amber-300 font-medium mb-2">Acknowledgements placeholder</p>
        <p>
          Acknowledgements section to be written. Will credit advisors, collaborators,
          computing resources (CRL01, caramel nodes), and open-source tools used in UDB's
          development (AmberTools, NAMD, openbabel, numpy, scipy, etc.).
        </p>
      </div>
    </section>

    <!-- Citation -->
    <section class="reveal reveal-up">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">Citation</h2>
      <CitationBlock compact={false} />
    </section>

    <!-- Contact -->
    <section class="reveal reveal-up">
      <h2 class="text-2xl font-bold text-slate-100 mb-4">Contact & Issues</h2>
      <div class="grid sm:grid-cols-2 gap-5">
        <div class="p-5 bg-slate-900 rounded-xl border border-slate-700">
          <h3 class="text-slate-200 font-semibold mb-2 flex items-center gap-2">
            <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Email
          </h3>
          <p class="text-slate-400 text-sm">hiruwalgampaya@gmail.com</p>
          <p class="text-slate-600 text-xs mt-1">For research questions and collaborations</p>
        </div>
        <div class="p-5 bg-slate-900 rounded-xl border border-slate-700">
          <h3 class="text-slate-200 font-semibold mb-2 flex items-center gap-2">
            <svg class="w-4 h-4 text-teal-400" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
            GitHub Issues
          </h3>
          <a href="https://github.com/HirushaW/universal-dendrimer-builder/issues" target="_blank" rel="noopener noreferrer" class="text-teal-400 text-sm hover:text-teal-300 transition-colors">github.com/HirushaW/universal-dendrimer-builder ↗</a>
          <p class="text-slate-600 text-xs mt-1">For bug reports and feature requests</p>
        </div>
      </div>
    </section>

  </div>
</Layout>
