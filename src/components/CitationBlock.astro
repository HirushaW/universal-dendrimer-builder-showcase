---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const bibtex = `@software{walgampaya2025udb,
  author  = {Walgampaya, Hirusha},
  title   = {{Universal Dendrimer Builder (UDB): An Open-Source Python
             Tool for Building, Parameterizing, and Simulating
             Dendrimer Nanostructures}},
  year    = {2025},
  version = {1.0},
  url     = {https://github.com/HirushaW/universal-dendrimer-builder},
  note    = {Citation pending peer-reviewed publication}
}`;
---

<div class={`rounded-xl border ${compact ? 'border-slate-700 bg-slate-900' : 'border-sky-500/20 bg-sky-500/5'} p-6`} id="citation">
  {!compact && (
    <div class="flex items-center gap-2 mb-4">
      <svg class="w-5 h-5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      <h3 class="text-slate-100 font-semibold">How to Cite UDB</h3>
    </div>
  )}

  <div class="flex items-start gap-2 p-3 rounded-lg bg-amber-500/10 border border-amber-500/20 mb-4">
    <svg class="w-4 h-4 text-amber-400 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
    </svg>
    <p class="text-amber-300 text-xs leading-relaxed">
      <strong>Citation pending.</strong> A peer-reviewed paper for UDB is in preparation.
      Until then, please cite using the BibTeX entry below and note the version number.
    </p>
  </div>

  <div class="relative">
    <pre class="code-block p-4 text-xs text-slate-300 overflow-x-auto leading-relaxed">{bibtex}</pre>
    <button
      id="copy-bibtex"
      onclick="navigator.clipboard.writeText(this.dataset.text).then(()=>{this.textContent='Copied!';setTimeout(()=>this.textContent='Copy BibTeX',1500)})"
      data-text={bibtex}
      class="absolute top-2 right-2 px-2.5 py-1 bg-slate-700 hover:bg-slate-600 text-slate-300 text-xs rounded-md transition-colors"
    >
      Copy BibTeX
    </button>
  </div>

  {!compact && (
    <p class="mt-3 text-slate-500 text-xs">
      For questions about UDB, open an issue on GitHub or contact the author via the
      <a href="/about/" class="text-sky-500 hover:text-sky-400 transition-colors">About page</a>.
    </p>
  )}
</div>
