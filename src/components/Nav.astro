---
interface Props {
  activeNav?: string;
}
const { activeNav } = Astro.props;

// Module cards for the Builder mega-panel (icon + label + one-line descriptor)
const modules = [
  { href: '/tools/udb/',            label: 'UDB Overview',      desc: 'Features & force-field matrix',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 6h16M4 12h10M4 18h7"/>` },
  { href: '/tools/udb/install/',    label: 'Installation',      desc: 'Linux · AmberTools · NAMD',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a1 1 0 001 1h14a1 1 0 001-1v-2"/>` },
  { href: '/tools/udb/manual/',     label: 'User Manual',       desc: 'Tab-by-tab workflow guide',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 5a2 2 0 012-2h9l5 5v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5z M14 3v5h5"/>` },
  { href: '/tools/udb/structures/', label: 'Structure Gallery', desc: 'Interactive 3D library',
    icon: `<circle cx="12" cy="12" r="2.2" stroke-width="1.7"/><ellipse cx="12" cy="12" rx="9" ry="4" stroke-width="1.4"/><ellipse cx="12" cy="12" rx="9" ry="4" stroke-width="1.4" transform="rotate(60 12 12)"/>` },
  { href: '/tools/udb/validation/', label: 'Benchmarks',        desc: 'Validation vs. literature',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>` },
  { href: '/tools/udb/changelog/',  label: 'Changelog',         desc: 'Version history',
    icon: `<circle cx="12" cy="12" r="8.5" stroke-width="1.7"/><path stroke-linecap="round" stroke-width="1.7" d="M12 7.5V12l3 2"/>` },
];

// Primary command tabs
const tabs = [
  { key: 'home', href: '/', label: 'Home',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M3 11l9-8 9 8M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10"/>` },
  { key: 'tools', href: '/tools/udb/', label: 'Builder', mega: true,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M14.7 6.3a4 4 0 00-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 005.4-5.4l-2.5 2.5-2.5-.6-.6-2.5 2.6-2.9z"/>` },
  { key: 'structures', href: '/tools/udb/structures/', label: 'Visualize',
    icon: `<circle cx="12" cy="12" r="2.4" stroke-width="1.7"/><ellipse cx="12" cy="12" rx="10" ry="4.4" stroke-width="1.4"/><ellipse cx="12" cy="12" rx="10" ry="4.4" stroke-width="1.4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4.4" stroke-width="1.4" transform="rotate(120 12 12)"/>` },
  { key: 'docs', href: '/tools/udb/validation/', label: 'Benchmarks',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>` },
  { key: 'about', href: '/about/', label: 'Profile',
    icon: `<circle cx="12" cy="8" r="3.4" stroke-width="1.7"/><path stroke-linecap="round" stroke-width="1.7" d="M5 20a7 7 0 0114 0"/>` },
];
---

<header class="sticky top-0 z-50">
  <div class="border-b border-[var(--hud-line-soft)] bg-[rgba(4,7,14,0.72)] backdrop-blur-xl">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 gap-4">

        <!-- Logo / callsign -->
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <div class="relative w-9 h-9 flex items-center justify-center">
            <span class="absolute inset-0 rounded-md border border-[var(--hud-line)] group-hover:border-[var(--hud-cy)] transition-colors"></span>
            <svg viewBox="0 0 24 24" class="w-5 h-5 text-[var(--hud-cy)]" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" style="filter:drop-shadow(0 0 4px rgba(44,232,216,0.6))">
              <circle cx="12" cy="12" r="2"/>
              <line x1="12" y1="10" x2="12" y2="4.5"/><line x1="12" y1="14" x2="12" y2="19.5"/>
              <line x1="10" y1="12" x2="4.5" y2="12"/><line x1="14" y1="12" x2="19.5" y2="12"/>
              <circle cx="12" cy="4.5" r="1.4" fill="currentColor" stroke="none"/>
              <circle cx="12" cy="19.5" r="1.4" fill="currentColor" stroke="none"/>
              <circle cx="4.5" cy="12" r="1.4" fill="currentColor" stroke="none"/>
              <circle cx="19.5" cy="12" r="1.4" fill="currentColor" stroke="none"/>
            </svg>
          </div>
          <div class="leading-none">
            <span class="font-hud text-slate-100 font-bold text-sm tracking-widest">UDB</span>
            <span class="font-mono text-[10px] text-[var(--hud-cy-deep)] block mt-1 tracking-[0.2em]">DENDRIMER//BUILDER</span>
          </div>
        </a>

        <!-- Desktop HUD tab bar -->
        <div class="hidden md:flex items-center gap-1 rounded-lg border border-[var(--hud-line-soft)] bg-[rgba(8,20,28,0.4)] px-1 py-1">
          {tabs.map(tab => (
            tab.mega ? (
              <div class="nav-mega" data-mega>
                <button
                  type="button"
                  class={`nav-tab ${activeNav === tab.key ? 'is-active' : ''}`}
                  data-mega-trigger
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="mega-builder"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={tab.icon} />
                  <span>{tab.label}</span>
                  <svg class="nav-caret w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6"/></svg>
                </button>

                <!-- Mega command panel -->
                <div id="mega-builder" class="mega-panel hud-panel hud-panel-solid hud-corners" data-mega-panel role="menu" aria-label="Builder modules">
                  <p class="mega-eyebrow">// UDB · MODULES</p>
                  <div class="mega-grid">
                    {modules.map(m => (
                      <a href={m.href} class="mega-card" role="menuitem">
                        <span class="mega-ico">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={m.icon} />
                        </span>
                        <span class="mega-text">
                          <span class="mega-label">{m.label}</span>
                          <span class="mega-desc">{m.desc}</span>
                        </span>
                      </a>
                    ))}
                    <a href="https://github.com/HirushaW/universal-dendrimer-builder" target="_blank" rel="noopener noreferrer" class="mega-card mega-card-cta" role="menuitem">
                      <span class="mega-ico">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/></svg>
                      </span>
                      <span class="mega-text">
                        <span class="mega-label">Source & Issues<span class="ml-1 text-[var(--hud-cy-deep)]">↗</span></span>
                        <span class="mega-desc">GitHub repository</span>
                      </span>
                    </a>
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={tab.href}
                class={`nav-tab ${activeNav === tab.key ? 'is-active' : ''}`}
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={tab.icon} />
                <span>{tab.label}</span>
              </a>
            )
          ))}
        </div>

        <!-- GitHub CTA -->
        <a
          href="https://github.com/HirushaW/universal-dendrimer-builder"
          target="_blank" rel="noopener noreferrer"
          class="hidden md:flex items-center gap-2 px-3.5 py-2 rounded-md border border-[var(--hud-line)] text-slate-300 text-xs font-mono hover:text-[var(--hud-cy-bright)] hover:border-[var(--hud-cy)] hover:bg-[rgba(44,232,216,0.06)] transition-colors shrink-0"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
          </svg>
          GITHUB
        </a>

        <!-- Mobile hamburger -->
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-md text-[var(--hud-cy)] border border-[var(--hud-line)]" aria-label="Toggle menu" aria-expanded="false">
          <svg class="w-5 h-5" id="icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg class="w-5 h-5 hidden" id="icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-[var(--hud-line-soft)] bg-[rgba(4,7,14,0.97)] backdrop-blur-xl">
    <div class="px-4 py-4 space-y-1 max-h-[80vh] overflow-y-auto">
      <p class="font-mono text-[10px] text-[var(--hud-cy-deep)] uppercase tracking-[0.2em] px-2 pb-2">// Systems</p>
      {tabs.map(tab => (
        <a href={tab.href} class={`flex items-center gap-2.5 px-2 py-2.5 font-display text-sm uppercase tracking-wider transition-colors ${activeNav === tab.key ? 'text-[var(--hud-cy-bright)]' : 'text-slate-300 hover:text-[var(--hud-cy-bright)]'}`}>
          <svg class="w-4 h-4 text-[var(--hud-cy)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={tab.icon} />
          {tab.label}
        </a>
      ))}
      <p class="font-mono text-[10px] text-[var(--hud-cy-deep)] uppercase tracking-[0.2em] px-2 pt-4 pb-2 mt-2">// Modules</p>
      <div class="grid grid-cols-1 gap-1.5">
        {modules.map(m => (
          <a href={m.href} class="flex items-start gap-3 px-2.5 py-2.5 rounded-lg border border-[var(--hud-line-soft)] bg-[rgba(44,232,216,0.03)] hover:border-[var(--hud-cy)] hover:bg-[rgba(44,232,216,0.07)] transition-colors">
            <span class="mt-0.5 text-[var(--hud-cy)]"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={m.icon} /></span>
            <span class="leading-tight">
              <span class="block font-display text-xs font-semibold text-slate-200 uppercase tracking-wide">{m.label}</span>
              <span class="block font-mono text-[10px] text-slate-500 mt-0.5">{m.desc}</span>
            </span>
          </a>
        ))}
      </div>
      <a href="https://github.com/HirushaW/universal-dendrimer-builder" target="_blank" rel="noopener noreferrer" class="block px-2 py-2.5 mt-3 font-mono text-xs text-slate-300 hover:text-[var(--hud-cy)] transition-colors">GITHUB ↗</a>
    </div>
  </div>
</header>

<style>
  /* ── Primary command tabs ─────────────────────────────────────────── */
  .nav-tab {
    position: relative;
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.55rem 0.9rem; border-radius: 8px;
    font-family: 'Chakra Petch', sans-serif;
    font-size: 0.78rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase;
    color: rgb(203, 213, 225);                 /* slate-300 - higher contrast than before */
    background: transparent; border: 0; cursor: pointer;
    transition: color var(--dur-fast) var(--ease-hud), background var(--dur-fast) var(--ease-hud);
  }
  .nav-tab:hover { color: var(--hud-cy-bright); background: rgba(44,232,216,0.06); }
  .nav-tab.is-active { color: var(--hud-cy-bright); }
  /* animated underline: scales in on hover, locked on for active */
  .nav-tab::after {
    content: ''; position: absolute; left: 0.9rem; right: 0.9rem; bottom: 2px; height: 2px;
    background: var(--hud-cy); box-shadow: 0 0 8px var(--hud-cy);
    transform: scaleX(0); transform-origin: center;
    transition: transform var(--dur-med) var(--ease-hud);
  }
  .nav-tab:hover::after { transform: scaleX(0.6); }
  .nav-tab.is-active::after { transform: scaleX(1); }
  .nav-tab:focus-visible { outline: 2px solid var(--hud-cy); outline-offset: 2px; }
  .nav-caret { opacity: 0.6; transition: transform var(--dur-fast) var(--ease-hud); }
  .nav-mega[data-open="true"] .nav-caret { transform: rotate(180deg); }

  /* ── Mega command panel ───────────────────────────────────────────── */
  .nav-mega { position: relative; }
  .mega-panel {
    position: absolute; top: calc(100% + 10px); left: 0;
    width: min(640px, calc(100vw - 3rem));
    padding: 0.9rem; z-index: 60;
    opacity: 0; visibility: hidden; pointer-events: none;
    transform: translateY(-6px);
    transition: opacity var(--dur-fast) var(--ease-hud),
                transform var(--dur-fast) var(--ease-hud),
                visibility var(--dur-fast);
  }
  .nav-mega[data-open="true"] .mega-panel {
    opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0);
  }
  .mega-eyebrow {
    font-family: 'JetBrains Mono', monospace; font-size: 0.62rem;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--hud-cy-deep); padding: 0 0.35rem 0.6rem;
  }
  .mega-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
  .mega-card {
    display: flex; align-items: center; gap: 0.7rem;
    padding: 0.6rem 0.7rem; border-radius: 10px;
    border: 1px solid transparent; background: transparent;
    transition: transform var(--dur-fast) var(--ease-hud),
                border-color var(--dur-fast) var(--ease-hud),
                background var(--dur-fast) var(--ease-hud),
                box-shadow var(--dur-fast) var(--ease-hud);
  }
  .mega-card:hover, .mega-card:focus-visible {
    transform: translateY(-2px); outline: none;
    border-color: var(--hud-line);
    background: rgba(44,232,216,0.06);
    box-shadow: inset 0 0 18px rgba(44,232,216,0.05), 0 8px 22px rgba(0,0,0,0.4);
  }
  .mega-ico {
    display: grid; place-items: center; flex-shrink: 0;
    width: 34px; height: 34px; border-radius: 8px;
    color: var(--hud-cy);
    border: 1px solid var(--hud-line);
    background: rgba(44,232,216,0.05);
    transition: color var(--dur-fast) var(--ease-hud), box-shadow var(--dur-fast) var(--ease-hud);
  }
  .mega-card:hover .mega-ico, .mega-card:focus-visible .mega-ico {
    color: var(--hud-cy-bright); box-shadow: 0 0 14px rgba(44,232,216,0.35);
  }
  .mega-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .mega-label {
    font-family: 'Chakra Petch', sans-serif; font-weight: 600; font-size: 0.8rem;
    color: rgb(226, 232, 240); letter-spacing: 0.01em;
  }
  .mega-card:hover .mega-label, .mega-card:focus-visible .mega-label { color: var(--hud-cy-bright); }
  .mega-desc { font-family: 'JetBrains Mono', monospace; font-size: 0.64rem; color: rgb(100, 116, 139); }
  .mega-card-cta { grid-column: 1 / -1; border-top: 1px solid var(--hud-line-soft); border-radius: 0 0 10px 10px; margin-top: 0.15rem; padding-top: 0.7rem; }

  @media (prefers-reduced-motion: reduce) {
    .nav-tab::after, .mega-panel, .mega-card, .nav-caret { transition: none !important; }
  }
</style>

<script is:inline>
  (function () {
    // ── Builder mega-panel: hover + click + focus + Esc + outside-click ──
    document.querySelectorAll('[data-mega]').forEach(function (wrap) {
      var trigger = wrap.querySelector('[data-mega-trigger]');
      var closeT = null;
      function set(open) {
        wrap.dataset.open = open ? 'true' : 'false';
        trigger && trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      function open()  { clearTimeout(closeT); set(true); }
      function close() { set(false); }
      function delayedClose() { clearTimeout(closeT); closeT = setTimeout(close, 130); }

      wrap.addEventListener('mouseenter', open);
      wrap.addEventListener('mouseleave', delayedClose);
      wrap.addEventListener('focusin', open);
      wrap.addEventListener('focusout', function (e) {
        if (!wrap.contains(e.relatedTarget)) close();
      });
      trigger && trigger.addEventListener('click', function (e) {
        e.preventDefault();
        wrap.dataset.open === 'true' ? close() : open();
      });
      wrap.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { close(); trigger && trigger.focus(); }
      });
      document.addEventListener('click', function (e) {
        if (!wrap.contains(e.target)) close();
      });
    });

    // ── Mobile drawer ──
    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    var iconOpen = document.getElementById('icon-open');
    var iconClose = document.getElementById('icon-close');
    btn && btn.addEventListener('click', function () {
      var isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      iconOpen.classList.toggle('hidden', !isOpen);
      iconClose.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  })();
</script>
