---
const year = new Date().getFullYear();
---

<footer class="relative mt-auto border-t border-[var(--hud-line-soft)] bg-[rgba(4,7,14,0.7)] backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">

      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="w-8 h-8 rounded-md border border-[var(--hud-line)] flex items-center justify-center">
            <svg viewBox="0 0 24 24" class="w-4 h-4 text-[var(--hud-cy)]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="filter:drop-shadow(0 0 4px rgba(44,232,216,0.6))">
              <circle cx="12" cy="12" r="2"/>
              <line x1="12" y1="10" x2="12" y2="4"/>
              <line x1="12" y1="14" x2="12" y2="20"/>
              <line x1="10" y1="12" x2="4" y2="12"/>
              <line x1="14" y1="12" x2="20" y2="12"/>
              <circle cx="12" cy="4" r="1.5" fill="currentColor" stroke="none"/>
              <circle cx="12" cy="20" r="1.5" fill="currentColor" stroke="none"/>
              <circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/>
              <circle cx="20" cy="12" r="1.5" fill="currentColor" stroke="none"/>
            </svg>
          </div>
          <span class="font-display text-slate-100 font-bold tracking-wide">Universal Dendrimer Builder</span>
        </div>
        <p class="text-slate-500 text-sm leading-relaxed max-w-xs">
          Open-source computational tool for building, parameterizing, and simulating
          dendrimer nanostructures. Developed at University of Peradeniya.
        </p>
        <div class="mt-4 flex items-center gap-2">
          <span class="hud-chip">v1.0</span>
          <span class="hud-chip">Open Source</span>
          <span class="hud-chip">Linux</span>
        </div>
      </div>

      <!-- UDB links -->
      <div>
        <h3 class="font-mono text-[11px] text-[var(--hud-cy)] tracking-[0.2em] uppercase mb-4">// UDB Tool</h3>
        <ul class="space-y-2.5">
          {[
            { href: '/tools/udb/install/', label: 'Installation' },
            { href: '/tools/udb/manual/', label: 'User Manual' },
            { href: '/tools/udb/validation/', label: 'Benchmarks' },
            { href: '/tools/udb/changelog/', label: 'Changelog' },
          ].map(l => (
            <li><a href={l.href} class="font-mono text-xs text-slate-400 hover:text-[var(--hud-cy-bright)] transition-colors"><span class="text-[var(--hud-cy-deep)] mr-1.5">›</span>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Other links -->
      <div>
        <h3 class="font-mono text-[11px] text-[var(--hud-cy)] tracking-[0.2em] uppercase mb-4">// Project</h3>
        <ul class="space-y-2.5">
          {[
            { href: '/docs/', label: 'Documentation' },
            { href: '/about/', label: 'About & Contact' },
            { href: 'https://github.com/HirushaW/universal-dendrimer-builder', label: 'GitHub ↗', external: true },
          ].map(l => (
            <li>
              <a
                href={l.href}
                class="font-mono text-xs text-slate-400 hover:text-[var(--hud-cy-bright)] transition-colors"
                {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="text-[var(--hud-cy-deep)] mr-1.5">›</span>{l.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <p class="text-slate-600 text-xs">Citation pending publication</p>
          <a href="/tools/udb/#citation" class="font-mono text-[var(--hud-cy-deep)] text-xs hover:text-[var(--hud-cy)] transition-colors">How to cite UDB →</a>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="font-mono text-slate-600 text-xs">
        © {year} Hirusha Walgampaya · University of Peradeniya · Open-source software.
      </p>
      <p class="font-mono text-slate-700 text-xs">
        Built with <a href="https://astro.build" class="hover:text-[var(--hud-cy)] transition-colors" target="_blank" rel="noopener noreferrer">Astro</a>
        · <a href="https://tailwindcss.com" class="hover:text-[var(--hud-cy)] transition-colors" target="_blank" rel="noopener noreferrer">Tailwind</a>
      </p>
    </div>
  </div>
</footer>
