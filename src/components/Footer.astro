---
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800 bg-slate-950 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">

      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-7 h-7 rounded-md bg-sky-500/10 border border-sky-500/40 flex items-center justify-center">
            <svg viewBox="0 0 24 24" class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <circle cx="12" cy="12" r="2"/>
              <line x1="12" y1="10" x2="12" y2="4"/>
              <line x1="12" y1="14" x2="12" y2="20"/>
              <line x1="10" y1="12" x2="4" y2="12"/>
              <line x1="14" y1="12" x2="20" y2="12"/>
              <circle cx="12" cy="4" r="1.5" fill="currentColor" stroke="none"/>
              <circle cx="12" cy="20" r="1.5" fill="currentColor" stroke="none"/>
              <circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/>
              <circle cx="20" cy="12" r="1.5" fill="currentColor" stroke="none"/>
            </svg>
          </div>
          <span class="text-slate-100 font-bold">Universal Dendrimer Builder</span>
        </div>
        <p class="text-slate-500 text-sm leading-relaxed max-w-xs">
          Open-source computational tool for building, parameterizing, and simulating
          dendrimer nanostructures. Developed at University of Peradeniya.
        </p>
        <div class="mt-4 flex items-center gap-3">
          <span class="badge bg-sky-500/10 text-sky-400 border border-sky-500/20">v1.0</span>
          <span class="badge bg-slate-800 text-slate-400 border border-slate-700">Open Source</span>
          <span class="badge bg-slate-800 text-slate-400 border border-slate-700">Linux</span>
        </div>
      </div>

      <!-- UDB links -->
      <div>
        <h3 class="text-slate-200 font-semibold text-sm mb-3">UDB Tool</h3>
        <ul class="space-y-2">
          {[
            { href: '/tools/udb/install/', label: 'Installation' },
            { href: '/tools/udb/manual/', label: 'User Manual' },
            { href: '/tools/udb/examples/', label: 'Examples' },
            { href: '/tools/udb/validation/', label: 'Benchmarks' },
            { href: '/tools/udb/changelog/', label: 'Changelog' },
          ].map(l => (
            <li><a href={l.href} class="text-slate-500 text-sm hover:text-sky-400 transition-colors">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Other links -->
      <div>
        <h3 class="text-slate-200 font-semibold text-sm mb-3">Project</h3>
        <ul class="space-y-2">
          {[
            { href: '/docs/', label: 'Documentation' },
            { href: '/about/', label: 'About & Contact' },
            { href: 'https://github.com/HirushaW/universal-dendrimer-builder', label: 'GitHub ↗', external: true },
          ].map(l => (
            <li>
              <a
                href={l.href}
                class="text-slate-500 text-sm hover:text-sky-400 transition-colors"
                {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6">
          <p class="text-slate-600 text-xs">Citation pending publication</p>
          <a href="/tools/udb/#citation" class="text-sky-600 text-xs hover:text-sky-400 transition-colors">How to cite UDB →</a>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-slate-600 text-xs">
        © {year} Hirusha Walgampaya, University of Peradeniya. UDB is open-source software.
      </p>
      <p class="text-slate-700 text-xs">
        Built with <a href="https://astro.build" class="hover:text-slate-500 transition-colors" target="_blank" rel="noopener noreferrer">Astro</a>
        · <a href="https://tailwindcss.com" class="hover:text-slate-500 transition-colors" target="_blank" rel="noopener noreferrer">Tailwind</a>
      </p>
    </div>
  </div>
</footer>
