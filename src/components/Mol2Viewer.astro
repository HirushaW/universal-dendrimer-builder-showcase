---
interface Props {
  id: string;
  monomerUrl: string;
  coreUrl: string;
  label?: string;
}
const { id, monomerUrl, coreUrl, label = '' } = Astro.props;
---

<div class="mol2-viewer-pair" data-id={id} data-monomer={monomerUrl} data-core={coreUrl}>
  <div class="grid grid-cols-2 gap-3">
    <div>
      <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2 text-center">Monomer</p>
      <div
        id={`viewer-${id}-monomer`}
        class="w-full rounded-xl border border-slate-700 overflow-hidden"
        style="height: 200px; background: #0b1221; position: relative;"
      >
        <div class="viewer-loading absolute inset-0 flex items-center justify-center">
          <div class="w-5 h-5 border-2 border-teal-500/30 border-t-teal-500 rounded-full animate-spin"></div>
        </div>
      </div>
    </div>
    <div>
      <p class="text-slate-500 text-xs font-medium uppercase tracking-wider mb-2 text-center">Core</p>
      <div
        id={`viewer-${id}-core`}
        class="w-full rounded-xl border border-slate-700 overflow-hidden"
        style="height: 200px; background: #0b1221; position: relative;"
      >
        <div class="viewer-loading absolute inset-0 flex items-center justify-center">
          <div class="w-5 h-5 border-2 border-teal-500/30 border-t-teal-500 rounded-full animate-spin"></div>
        </div>
      </div>
    </div>
  </div>
  <p class="text-slate-600 text-xs text-center mt-2 mono">Drag to rotate · Scroll to zoom · Right-drag to pan</p>
</div>
