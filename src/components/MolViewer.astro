---
/**
 * MolViewer - a single live 3D structure (3Dmol.js) in a HUD frame.
 * Rotate (drag), zoom (scroll), pan (right-drag). Click an atom to label its
 * index + element + GAFF type. Optional auto-spin. Lazy-inits on scroll.
 *
 * Requires <MolViewerRuntime /> once on the page.
 */
interface Props {
  id: string;
  url: string;            // /mol2/....mol2
  label?: string;         // caption under the viewer
  sublabel?: string;      // dim caption
  height?: string;
  spin?: boolean;         // auto-spin on load
  zoom?: number;          // initial zoom factor (default 0.9)
  accent?: string;        // hud cyan by default; pass a hex to tint the frame
}
const {
  id, url, label = '', sublabel = '', height = '300px',
  spin = false, zoom = 0.9, accent = '#2ce8d8',
} = Astro.props;
---

<div class="mol-viewer-wrap">
  <div
    id={`mv-${id}`}
    class="mol-viewer hud-corners relative w-full rounded-xl overflow-hidden"
    data-url={url}
    data-spin={spin ? '1' : '0'}
    data-zoom={zoom}
    style={`height:${height};background:#060e16;border:1px solid ${accent}44;box-shadow:0 0 30px ${accent}18, inset 0 0 40px rgba(0,0,0,.5)`}
  >
    <!-- loading -->
    <div class="mv-loading absolute inset-0 flex flex-col items-center justify-center gap-3 pointer-events-none">
      <div class="w-6 h-6 border-2 rounded-full animate-spin" style={`border-color:${accent}33;border-top-color:${accent}`}></div>
      <span class="font-mono text-[10px] tracking-[0.2em]" style={`color:${accent}`}>LOADING STRUCTURE…</span>
    </div>

    <!-- controls -->
    <div class="mv-controls absolute top-2 right-2 flex gap-1.5 opacity-0 transition-opacity z-10">
      <button data-act="spin"  title="Toggle spin"  class="mv-btn" aria-label="Toggle spin">
        <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v6h6M20 20v-6h-6M20 8a8 8 0 00-14.9-2M4 16a8 8 0 0014.9 2"/></svg>
      </button>
      <button data-act="reset" title="Reset view" class="mv-btn" aria-label="Reset view">
        <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3a9 9 0 100 18 9 9 0 000-18zm0 5v4l3 2"/></svg>
      </button>
    </div>

    <!-- atom info chip -->
    <div class="mv-atom absolute bottom-2 left-2 font-mono text-[10px] px-2 py-1 rounded opacity-0 transition-opacity z-10"
         style={`background:rgba(4,7,14,.8);border:1px solid ${accent}44;color:${accent}`}></div>
  </div>

  {(label || sublabel) && (
    <div class="mt-2 px-1">
      {label && <div class="font-display text-sm font-semibold" style={`color:${accent}`}>{label}</div>}
      {sublabel && <div class="font-mono text-[10px] text-slate-500 mt-0.5">{sublabel}</div>}
    </div>
  )}
</div>

<style>
  .mv-btn {
    display:flex; align-items:center; justify-content:center;
    width:26px; height:26px; border-radius:6px;
    color:#2ce8d8; background:rgba(4,7,14,.7);
    border:1px solid rgba(44,232,216,.28);
    transition:background .2s, color .2s, border-color .2s;
  }
  .mv-btn:hover { background:rgba(44,232,216,.14); color:#6ffff2; border-color:#2ce8d8; }
  .mol-viewer:hover .mv-controls { opacity:1; }
  .mol-viewer canvas { border-radius:12px; }
</style>
